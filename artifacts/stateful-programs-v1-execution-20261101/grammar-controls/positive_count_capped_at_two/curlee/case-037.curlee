fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            if ((acc < 2)) {
                acc = (acc + 1);
            }
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -19;
    input[1] = 75;
    input[2] = 20;
    input[3] = -36;
    input[4] = 32;
    input[5] = 77;
    input[6] = 93;
    input[7] = 49;
    input[8] = 13;
    input[9] = 11;
    input[10] = 64;
    input[11] = -90;
    input[12] = -37;
    input[13] = 29;
    input[14] = -16;
    input[15] = -19;
    input[16] = -58;
    input[17] = 83;
    input[18] = 85;
    input[19] = 95;
    input[20] = -76;
    input[21] = -75;
    input[22] = 55;
    input[23] = -9;
    input[24] = 16;
    input[25] = 57;
    input[26] = -34;
    input[27] = 88;
    if (process(&input, 28) != 2) {
        return 1;
    }
    return 0;
}
