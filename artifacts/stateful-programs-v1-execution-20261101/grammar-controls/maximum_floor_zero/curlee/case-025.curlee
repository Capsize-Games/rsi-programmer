fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -91;
    input[1] = 63;
    input[2] = 82;
    input[3] = 1;
    input[4] = -47;
    input[5] = 66;
    input[6] = -82;
    input[7] = -5;
    input[8] = -33;
    input[9] = 27;
    input[10] = -85;
    input[11] = 59;
    input[12] = -68;
    input[13] = -30;
    input[14] = -76;
    input[15] = -20;
    input[16] = 43;
    input[17] = 34;
    input[18] = -13;
    input[19] = -1;
    input[20] = -92;
    input[21] = -30;
    input[22] = -93;
    input[23] = -87;
    input[24] = -37;
    input[25] = -57;
    input[26] = 25;
    input[27] = 89;
    input[28] = 60;
    input[29] = -65;
    input[30] = 90;
    input[31] = -44;
    input[32] = 32;
    if (process(&input, 33) != 90) {
        return 1;
    }
    return 0;
}
