    input[15] = 71;
    input[16] = 60;
    input[17] = 60;
    input[18] = -54;
    input[19] = 28;
    input[20] = 85;
    input[21] = -19;
    input[22] = 75;
    input[23] = 97;
    input[24] = 97;
    input[25] = 35;
    input[26] = -41;
    input[27] = -75;
    input[28] = 63;
    input[29] = -92;
    input[30] = -40;
    input[31] = 2;
    input[32] = -60;
    input[33] = -35;
    input[34] = -77;
    input[35] = 96;
