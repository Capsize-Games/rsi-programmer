fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 6;
    input[1] = -70;
    input[2] = -19;
    input[3] = 56;
    input[4] = -41;
    input[5] = -22;
    input[6] = -38;
    input[7] = -23;
    input[8] = 30;
    input[9] = -5;
    input[10] = 90;
    input[11] = -29;
    input[12] = -11;
    input[13] = 76;
    input[14] = -58;
    input[15] = 48;
    input[16] = -90;
    input[17] = -54;
    input[18] = -87;
    input[19] = 86;
    input[20] = -17;
    input[21] = 93;
    input[22] = 99;
    input[23] = 22;
    input[24] = 80;
    input[25] = 83;
    input[26] = 74;
    input[27] = -63;
    input[28] = -20;
    input[29] = -29;
    input[30] = 54;
    input[31] = 75;
    input[32] = -80;
    input[33] = 50;
    input[34] = -57;
    if (process(&input, 35) != 99) {
        return 1;
    }
    return 0;
}
