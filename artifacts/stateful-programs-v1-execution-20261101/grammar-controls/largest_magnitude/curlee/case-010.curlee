fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -68;
    input[1] = -74;
    input[2] = -36;
    input[3] = -97;
    input[4] = -26;
    input[5] = 60;
    input[6] = 33;
    input[7] = -87;
    input[8] = -27;
    input[9] = -86;
    input[10] = -72;
    input[11] = 12;
    input[12] = -95;
    input[13] = -78;
    input[14] = -94;
    input[15] = 80;
    input[16] = -16;
    input[17] = 50;
    input[18] = -34;
    input[19] = -54;
    input[20] = -46;
    input[21] = 98;
    if (process(&input, 22) != 98) {
        return 1;
    }
    return 0;
}
