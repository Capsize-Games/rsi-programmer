fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 1)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -68;
    input[1] = 9;
    input[2] = 92;
    input[3] = 89;
    input[4] = 56;
    input[5] = -30;
    input[6] = 29;
    input[7] = -8;
    input[8] = 14;
    input[9] = 55;
    input[10] = 26;
    input[11] = -8;
    input[12] = 79;
    input[13] = -83;
    input[14] = 16;
    if (process(&input, 15) != 2) {
        return 1;
    }
    return 0;
}
