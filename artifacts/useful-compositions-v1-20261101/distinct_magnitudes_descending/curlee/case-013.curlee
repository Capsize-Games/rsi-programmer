fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 256]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    if (count < 0 || count > 256) { return -1; }
    let s0: [Int; 256] = [0; 256];
    let len0: Int = 0;
    for (i0 in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant len0 >= 0 && len0 <= i0; ] {
        if (i0 < 0 || i0 >= 256 || len0 < 0 || len0 >= 256) { return -1; }
        let value: Int = input[i0];
        let duplicate: Bool = false;
        for (j0 in 0..len0)
            [ invariant len0 >= 0 && len0 <= i0;
              invariant i0 >= 0 && i0 < count;
              invariant count <= 256; ] {
            if (j0 < 0 || j0 >= 256) { return -1; }
            if (s0[j0] == value) {
                duplicate = true;
            }
        }
        if (!duplicate) {
            s0[len0] = value;
            len0 = len0 + 1;
        }
    }
    let s1: [Int; 256] = [0; 256];
    let len1: Int = 0;
    for (i1 in 0..len0)
        [ invariant len0 >= 0 && len0 <= 256;
          invariant len1 >= 0 && len1 <= i1; ] {
        if (i1 < 0 || i1 >= 256 || len1 < 0 || len1 >= 256) { return -1; }
        let value: Int = s0[i1];
        if (value < 0) {
            s1[len1] = 0 - value;
        } else {
            s1[len1] = value;
        }
        len1 = len1 + 1;
    }
    let s2: [Int; 256] = [0; 256];
    let len2: Int = 0;
    for (i2 in 0..len1)
        [ invariant len1 >= 0 && len1 <= 256;
          invariant len2 >= 0 && len2 <= i2; ] {
        if (i2 < 0 || i2 >= 256 || len2 < 0 || len2 >= 256) { return -1; }
        let value: Int = s1[i2];
        s2[len2] = value;
        len2 = len2 + 1;
    }
    if (len2 > 1) {
    for (a2 in 0..len2)
        [ invariant len2 > 1 && len2 <= 256; ] {
        for (b2 in 0..(len2 - 1))
            [ invariant len2 > 1 && len2 <= 256; ] {
            if (b2 < 0 || b2 >= 255) { return -1; }
            let first: Int = s2[b2];
            let second: Int = s2[b2 + 1];
            if (first < second) {
                s2[b2] = second;
                s2[b2 + 1] = first;
            }
        }
    }
    }
    for (i in 0..len2)
        [ invariant len2 >= 0 && len2 <= 256; ] {
        if (i < 0 || i >= 256) { return -1; }
        output[i] = s2[i];
    }
    return len2;
}

fn correct(input: &[Int; 256], count: Int,
           expected: &[Int; 256], expected_count: Int) -> Bool
    [ requires count >= 0 && count <= 256;
      requires expected_count >= 0 && expected_count <= 256; ]
{
    let output: [Int; 256] = [0; 256];
    let size: Int = process(&input, count, &mut output);
    if (size != expected_count) { return false; }
    for (i in 0..expected_count)
        [ invariant expected_count >= 0 && expected_count <= 256; ] {
        if (i < 0 || i >= 256) { return false; }
        if (output[i] != expected[i]) { return false; }
    }
    return true;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let expected: [Int; 256] = [0; 256];
    input[0] = 47;
    input[1] = -85;
    input[2] = -80;
    input[3] = -57;
    input[4] = -52;
    input[5] = -31;
    input[6] = -63;
    input[7] = 7;
    input[8] = 88;
    input[9] = 72;
    input[10] = 64;
    input[11] = -68;
    input[12] = -28;
    input[13] = -43;
    input[14] = -17;
    input[15] = -24;
    input[16] = -78;
    input[17] = -25;
    input[18] = -22;
    input[19] = 52;
    input[20] = -91;
    expected[0] = 91;
    expected[1] = 88;
    expected[2] = 85;
    expected[3] = 80;
    expected[4] = 78;
    expected[5] = 72;
    expected[6] = 68;
    expected[7] = 64;
    expected[8] = 63;
    expected[9] = 57;
    expected[10] = 52;
    expected[11] = 47;
    expected[12] = 43;
    expected[13] = 31;
    expected[14] = 28;
    expected[15] = 25;
    expected[16] = 24;
    expected[17] = 22;
    expected[18] = 17;
    expected[19] = 7;
    if (!correct(&input, 21, &expected, 20)) { return 1; }
    return 0;
}
