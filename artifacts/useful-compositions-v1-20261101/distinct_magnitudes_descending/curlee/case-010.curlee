fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 256]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    if (count < 0 || count > 256) { return -1; }
    let s0: [Int; 256] = [0; 256];
    let len0: Int = 0;
    for (i0 in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant len0 >= 0 && len0 <= i0; ] {
        if (i0 < 0 || i0 >= 256 || len0 < 0 || len0 >= 256) { return -1; }
        let value: Int = input[i0];
        let duplicate: Bool = false;
        for (j0 in 0..len0)
            [ invariant len0 >= 0 && len0 <= i0;
              invariant i0 >= 0 && i0 < count;
              invariant count <= 256; ] {
            if (j0 < 0 || j0 >= 256) { return -1; }
            if (s0[j0] == value) {
                duplicate = true;
            }
        }
        if (!duplicate) {
            s0[len0] = value;
            len0 = len0 + 1;
        }
    }
    let s1: [Int; 256] = [0; 256];
    let len1: Int = 0;
    for (i1 in 0..len0)
        [ invariant len0 >= 0 && len0 <= 256;
          invariant len1 >= 0 && len1 <= i1; ] {
        if (i1 < 0 || i1 >= 256 || len1 < 0 || len1 >= 256) { return -1; }
        let value: Int = s0[i1];
        if (value < 0) {
            s1[len1] = 0 - value;
        } else {
            s1[len1] = value;
        }
        len1 = len1 + 1;
    }
    let s2: [Int; 256] = [0; 256];
    let len2: Int = 0;
    for (i2 in 0..len1)
        [ invariant len1 >= 0 && len1 <= 256;
          invariant len2 >= 0 && len2 <= i2; ] {
        if (i2 < 0 || i2 >= 256 || len2 < 0 || len2 >= 256) { return -1; }
        let value: Int = s1[i2];
        s2[len2] = value;
        len2 = len2 + 1;
    }
    if (len2 > 1) {
    for (a2 in 0..len2)
        [ invariant len2 > 1 && len2 <= 256; ] {
        for (b2 in 0..(len2 - 1))
            [ invariant len2 > 1 && len2 <= 256; ] {
            if (b2 < 0 || b2 >= 255) { return -1; }
            let first: Int = s2[b2];
            let second: Int = s2[b2 + 1];
            if (first < second) {
                s2[b2] = second;
                s2[b2 + 1] = first;
            }
        }
    }
    }
    for (i in 0..len2)
        [ invariant len2 >= 0 && len2 <= 256; ] {
        if (i < 0 || i >= 256) { return -1; }
        output[i] = s2[i];
    }
    return len2;
}

fn correct(input: &[Int; 256], count: Int,
           expected: &[Int; 256], expected_count: Int) -> Bool
    [ requires count >= 0 && count <= 256;
      requires expected_count >= 0 && expected_count <= 256; ]
{
    let output: [Int; 256] = [0; 256];
    let size: Int = process(&input, count, &mut output);
    if (size != expected_count) { return false; }
    for (i in 0..expected_count)
        [ invariant expected_count >= 0 && expected_count <= 256; ] {
        if (i < 0 || i >= 256) { return false; }
        if (output[i] != expected[i]) { return false; }
    }
    return true;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let expected: [Int; 256] = [0; 256];
    input[0] = -67;
    input[1] = 20;
    input[2] = 87;
    input[3] = -8;
    input[4] = -4;
    input[5] = 7;
    input[6] = 33;
    input[7] = 76;
    input[8] = -29;
    input[9] = -21;
    input[10] = -17;
    input[11] = 68;
    input[12] = 27;
    input[13] = -48;
    input[14] = -47;
    input[15] = -94;
    input[16] = -38;
    input[17] = -96;
    input[18] = 36;
    input[19] = -23;
    input[20] = 27;
    input[21] = 25;
    input[22] = 14;
    input[23] = 93;
    input[24] = 60;
    input[25] = -33;
    input[26] = 62;
    input[27] = 53;
    input[28] = -84;
    input[29] = -37;
    input[30] = 85;
    input[31] = -89;
    input[32] = 59;
    expected[0] = 96;
    expected[1] = 94;
    expected[2] = 93;
    expected[3] = 89;
    expected[4] = 87;
    expected[5] = 85;
    expected[6] = 84;
    expected[7] = 76;
    expected[8] = 68;
    expected[9] = 67;
    expected[10] = 62;
    expected[11] = 60;
    expected[12] = 59;
    expected[13] = 53;
    expected[14] = 48;
    expected[15] = 47;
    expected[16] = 38;
    expected[17] = 37;
    expected[18] = 36;
    expected[19] = 33;
    expected[20] = 29;
    expected[21] = 27;
    expected[22] = 25;
    expected[23] = 23;
    expected[24] = 21;
    expected[25] = 20;
    expected[26] = 17;
    expected[27] = 14;
    expected[28] = 8;
    expected[29] = 7;
    expected[30] = 4;
    if (!correct(&input, 33, &expected, 31)) { return 1; }
    return 0;
}
