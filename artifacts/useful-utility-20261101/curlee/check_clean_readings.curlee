fn process(input: Vec) -> Vec {
    let s0: Vec = __vec_new_int(4096);
    let len0: Int = __vec_len_int(input);
    for (i0 in 0..len0) {
        let value: Int = __vec_get_int(input, i0);
        if (value > 0) {
            __vec_push_int(s0, value);
        }
    }
    let s1: Vec = __vec_new_int(4096);
    let len1: Int = __vec_len_int(s0);
    for (i1 in 0..len1) {
        let value: Int = __vec_get_int(s0, i1);
        let duplicate: Bool = false;
        let used: Int = __vec_len_int(s1);
        for (j1 in 0..used) {
            if (__vec_get_int(s1, j1) == value) {
                duplicate = true;
            }
        }
        if (duplicate == false) {
            __vec_push_int(s1, value);
        }
    }
    let s2: Vec = __vec_new_int(4096);
    let len2: Int = __vec_len_int(s1);
    for (i2 in 0..len2) {
        let value: Int = __vec_get_int(s1, i2);
        __vec_push_int(s2, value);
    }
    for (a2 in 0..len2) {
        for (b2 in 0..(len2 - 1)) {
            let first: Int = __vec_get_int(s2, b2);
            let second: Int = __vec_get_int(s2, b2 + 1);
            if (first > second) {
                __vec_set_int(s2, b2, second);
                __vec_set_int(s2, b2 + 1, first);
            }
        }
    }
    return s2;
}

fn correct(input: Vec, expected: Vec) -> Bool {
    let result: Vec = process(input);
    let count: Int = __vec_len_int(expected);
    if (__vec_len_int(result) != count) {
