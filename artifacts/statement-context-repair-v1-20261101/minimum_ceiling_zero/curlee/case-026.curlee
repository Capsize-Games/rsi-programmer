fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value <= acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -17;
    input[1] = 44;
    input[2] = -1;
    input[3] = -38;
    input[4] = -17;
    input[5] = 40;
    input[6] = -37;
    input[7] = 84;
    input[8] = -64;
    input[9] = -36;
    input[10] = -58;
    input[11] = 14;
    input[12] = 34;
    input[13] = 50;
    input[14] = 98;
    input[15] = 2;
    input[16] = -29;
    input[17] = -36;
    input[18] = 1;
    input[19] = 49;
    input[20] = 20;
    input[21] = 93;
    input[22] = 97;
    input[23] = 75;
    input[24] = 88;
    if (process(&input, 25) != -64) {
        return 1;
    }
    return 0;
}
