    input[7] = -99;
    input[8] = 85;
    input[9] = 45;
    input[10] = 42;
    input[11] = -85;
    input[12] = -85;
    input[13] = -44;
    input[14] = 6;
    input[15] = 12;
    input[16] = 15;
    input[17] = 43;
    input[18] = -84;
    input[19] = -28;
    input[20] = 31;
    input[21] = -88;
    input[22] = 83;
    input[23] = -95;
    input[24] = 74;
    input[25] = 59;
    input[26] = -72;
    input[27] = -18;
    input[28] = -30;
    input[29] = 67;
    input[30] = 26;
    input[31] = -88;
    input[32] = 40;
    input[33] = -27;
    input[34] = 21;
    if (process(&input, 35) != 705) {
        return 1;
    }
    return 0;
}
