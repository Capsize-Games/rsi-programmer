fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -21;
    input[1] = 42;
    input[2] = 69;
    input[3] = 18;
    input[4] = 61;
    input[5] = 39;
    input[6] = 63;
    input[7] = -73;
    input[8] = -99;
    input[9] = -92;
    input[10] = 76;
    input[11] = 95;
    input[12] = -91;
    input[13] = -37;
    input[14] = -33;
    input[15] = 92;
    input[16] = -32;
    input[17] = -45;
    input[18] = -72;
    if (process(&input, 19) != 555) {
        return 1;
    }
    return 0;
}
