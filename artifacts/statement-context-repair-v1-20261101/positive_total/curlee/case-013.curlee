    input[11] = 3;
    input[12] = -19;
    input[13] = -66;
    input[14] = 70;
    input[15] = -70;
    input[16] = 43;
    input[17] = 32;
    input[18] = -2;
    input[19] = -32;
    input[20] = -93;
    input[21] = 97;
    input[22] = -41;
    input[23] = 10;
    input[24] = 0;
    input[25] = 5;
    input[26] = 78;
    input[27] = -50;
    input[28] = -77;
    input[29] = 92;
    input[30] = 40;
    input[31] = -26;
    input[32] = -21;
    input[33] = 75;
    input[34] = 66;
    input[35] = 28;
    input[36] = -86;
    if (process(&input, 37) != 1247) {
        return 1;
    }
    return 0;
}
