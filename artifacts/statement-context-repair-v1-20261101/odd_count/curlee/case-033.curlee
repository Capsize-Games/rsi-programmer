fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((value % 2) != 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 97;
    input[1] = -13;
    input[2] = 47;
    input[3] = 22;
    input[4] = 31;
    input[5] = -68;
    input[6] = -60;
    input[7] = -91;
    input[8] = 50;
    input[9] = 6;
    input[10] = -99;
    input[11] = 27;
    input[12] = -62;
    input[13] = -81;
    input[14] = 27;
    input[15] = -3;
    input[16] = -48;
    input[17] = -7;
    input[18] = -48;
    input[19] = -26;
    input[20] = 25;
    input[21] = -82;
    input[22] = -7;
    input[23] = 64;
    if (process(&input, 24) != 13) {
        return 1;
    }
    return 0;
}
