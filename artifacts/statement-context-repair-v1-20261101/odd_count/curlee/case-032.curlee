fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((value % 2) != 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 24;
    input[1] = 19;
    input[2] = -30;
    input[3] = 44;
    input[4] = -58;
    input[5] = 10;
    input[6] = -57;
    input[7] = -13;
    input[8] = -45;
    input[9] = 79;
    input[10] = 0;
    input[11] = 55;
    input[12] = -97;
    input[13] = -96;
    if (process(&input, 14) != 7) {
        return 1;
    }
    return 0;
}
