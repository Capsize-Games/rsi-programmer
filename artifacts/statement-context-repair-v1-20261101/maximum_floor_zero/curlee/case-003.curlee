fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -22;
    input[1] = -64;
    input[2] = -37;
    input[3] = 3;
    input[4] = 52;
    input[5] = 39;
    input[6] = 45;
    input[7] = -58;
    input[8] = 72;
    input[9] = -64;
    input[10] = -66;
    input[11] = 89;
    input[12] = -27;
    input[13] = 52;
    input[14] = 70;
    input[15] = -40;
    input[16] = -26;
    input[17] = -1;
    input[18] = -20;
    input[19] = -60;
    input[20] = 60;
    input[21] = -92;
    input[22] = 22;
    input[23] = 50;
    input[24] = 48;
    input[25] = -14;
    input[26] = 47;
    input[27] = -1;
    input[28] = 79;
    input[29] = -81;
    input[30] = -63;
    input[31] = -65;
    input[32] = -58;
    input[33] = 40;
    input[34] = -45;
    input[35] = 5;
    if (process(&input, 36) != 89) {
        return 1;
    }
    return 0;
}
