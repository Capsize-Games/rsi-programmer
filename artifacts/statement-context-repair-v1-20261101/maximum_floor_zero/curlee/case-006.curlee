fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -33;
    input[1] = 75;
    input[2] = -8;
    input[3] = -59;
    input[4] = 4;
    input[5] = 60;
    input[6] = 66;
    input[7] = -39;
    input[8] = -28;
    input[9] = 52;
    input[10] = 91;
    input[11] = 75;
    input[12] = 81;
    input[13] = -78;
    input[14] = 88;
    input[15] = 84;
    input[16] = -55;
    input[17] = -73;
    input[18] = 11;
    input[19] = 98;
    input[20] = -18;
    input[21] = -98;
    input[22] = -89;
    input[23] = -65;
    input[24] = 37;
    input[25] = 97;
    input[26] = 67;
    input[27] = -63;
    if (process(&input, 28) != 98) {
        return 1;
    }
    return 0;
}
