fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 2)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -35;
    input[1] = 83;
    input[2] = -47;
    input[3] = -92;
    input[4] = 97;
    input[5] = 34;
    input[6] = 3;
    input[7] = 30;
    input[8] = 17;
    input[9] = -62;
    input[10] = -41;
    input[11] = 5;
    input[12] = 16;
    input[13] = 75;
    if (process(&input, 14) != 9) {
        return 1;
    }
    return 0;
}
