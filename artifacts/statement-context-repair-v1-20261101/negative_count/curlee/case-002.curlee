fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 94;
    input[1] = -35;
    input[2] = -12;
    input[3] = -8;
    input[4] = -23;
    input[5] = -22;
    input[6] = -36;
    input[7] = -66;
    input[8] = 72;
    input[9] = -29;
    input[10] = -26;
    input[11] = -42;
    input[12] = -1;
    input[13] = 86;
    input[14] = 35;
    input[15] = -44;
    input[16] = 24;
    input[17] = 84;
    input[18] = -68;
    input[19] = -27;
    input[20] = 76;
    input[21] = 55;
    input[22] = -19;
    input[23] = -20;
    input[24] = 32;
    input[25] = -9;
    input[26] = -1;
    input[27] = 35;
    input[28] = 3;
    input[29] = 87;
    input[30] = -39;
    if (process(&input, 31) != 19) {
        return 1;
    }
    return 0;
}
