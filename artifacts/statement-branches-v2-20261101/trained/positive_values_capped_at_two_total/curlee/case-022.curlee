fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
        if (((value + -1) > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 93;
    input[1] = 0;
    input[2] = -4;
    input[3] = 12;
    input[4] = 60;
    input[5] = 60;
    input[6] = 71;
    input[7] = 46;
    input[8] = -35;
    input[9] = 31;
    input[10] = 8;
    input[11] = 38;
    input[12] = -51;
    input[13] = 31;
    input[14] = -54;
    input[15] = -55;
    input[16] = 56;
    input[17] = -64;
    input[18] = 82;
    input[19] = -26;
    input[20] = -16;
    input[21] = 89;
    input[22] = 70;
    if (process(&input, 23) != 28) {
        return 1;
    }
    return 0;
}
