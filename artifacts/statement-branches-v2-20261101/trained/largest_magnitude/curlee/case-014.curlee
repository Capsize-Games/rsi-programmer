fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 87;
    input[1] = 21;
    input[2] = -16;
    input[3] = 53;
    input[4] = -58;
    input[5] = -39;
    input[6] = -98;
    input[7] = 34;
    input[8] = 91;
    input[9] = -39;
    input[10] = 8;
    input[11] = -91;
    input[12] = -36;
    input[13] = -34;
    input[14] = 15;
    input[15] = 32;
    input[16] = 8;
    input[17] = 26;
    input[18] = -6;
    input[19] = -91;
    input[20] = -7;
    input[21] = 77;
    input[22] = -76;
    input[23] = -34;
    if (process(&input, 24) != 98) {
        return 1;
    }
    return 0;
}
