fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -48;
    input[1] = 16;
    input[2] = -22;
    input[3] = 69;
    input[4] = 20;
    input[5] = 24;
    input[6] = 39;
    input[7] = -16;
    input[8] = -75;
    input[9] = -77;
    input[10] = 85;
    input[11] = -28;
    input[12] = 80;
    input[13] = -8;
    input[14] = -5;
    input[15] = -82;
    input[16] = 24;
    input[17] = 72;
    input[18] = 93;
    input[19] = 65;
    input[20] = 33;
    input[21] = 38;
    input[22] = 58;
    if (process(&input, 23) != 93) {
        return 1;
    }
    return 0;
}
