    input[14] = 50;
    input[15] = 54;
    input[16] = -8;
    input[17] = 93;
    input[18] = -3;
    input[19] = 57;
    input[20] = -48;
    input[21] = 55;
    input[22] = 42;
    input[23] = 49;
    input[24] = 53;
    input[25] = -57;
    input[26] = 42;
    input[27] = -25;
    input[28] = -80;
    input[29] = -99;
    input[30] = 40;
    input[31] = -15;
    input[32] = -71;
    input[33] = -56;
    input[34] = 43;
    input[35] = 63;
    input[36] = 59;
    input[37] = 93;
    if (process(&input, 38) != 99) {
        return 1;
    }
    return 0;
}
