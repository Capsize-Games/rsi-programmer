fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 50;
    input[1] = -23;
    input[2] = 73;
    input[3] = 71;
    input[4] = -70;
    input[5] = 64;
    input[6] = 42;
    input[7] = -4;
    input[8] = 62;
    input[9] = 35;
    input[10] = 37;
    input[11] = -27;
    input[12] = -38;
    input[13] = -61;
    input[14] = -27;
    input[15] = 33;
    input[16] = 17;
    input[17] = 26;
    input[18] = -15;
    input[19] = -30;
    input[20] = 75;
    if (process(&input, 21) != 75) {
        return 1;
    }
    return 0;
}
