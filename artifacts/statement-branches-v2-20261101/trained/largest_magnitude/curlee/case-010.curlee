fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -58;
    input[1] = 84;
    input[2] = -56;
    input[3] = 49;
    input[4] = -38;
    input[5] = 79;
    input[6] = 40;
    input[7] = 48;
    input[8] = -79;
    input[9] = 53;
    input[10] = 59;
    input[11] = -5;
    input[12] = 43;
    input[13] = 60;
    input[14] = 38;
    input[15] = -77;
    input[16] = -72;
    input[17] = -17;
    input[18] = 83;
    input[19] = 70;
    input[20] = -57;
    input[21] = 74;
    input[22] = 77;
    input[23] = -35;
    input[24] = 31;
    input[25] = 72;
    input[26] = -25;
    input[27] = 45;
    input[28] = 42;
    input[29] = -68;
    input[30] = 33;
    input[31] = -51;
    input[32] = 35;
    input[33] = -60;
    input[34] = 75;
    if (process(&input, 35) != 84) {
        return 1;
    }
    return 0;
}
