fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -20;
    input[1] = -25;
    input[2] = -12;
    input[3] = 98;
    input[4] = 1;
    input[5] = 5;
    input[6] = 80;
    input[7] = 66;
    input[8] = -46;
    input[9] = 25;
    input[10] = -36;
    input[11] = 28;
    input[12] = -97;
    input[13] = 44;
    input[14] = -19;
    input[15] = 85;
    input[16] = -99;
    input[17] = -21;
    input[18] = 57;
    input[19] = 68;
    input[20] = -12;
    input[21] = -75;
    input[22] = -97;
    input[23] = -23;
    input[24] = -78;
    input[25] = -65;
    input[26] = 74;
    input[27] = 64;
    input[28] = 57;
    input[29] = 64;
    input[30] = 35;
    if (process(&input, 31) != 98) {
        return 1;
    }
    return 0;
}
