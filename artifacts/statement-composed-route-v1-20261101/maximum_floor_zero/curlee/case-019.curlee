    input[13] = -2;
    input[14] = 95;
    input[15] = 78;
    input[16] = 84;
    input[17] = 47;
    input[18] = -8;
    input[19] = 97;
    input[20] = -82;
    input[21] = -32;
    input[22] = 45;
    input[23] = 100;
    input[24] = 91;
    input[25] = 59;
    input[26] = -5;
    input[27] = -33;
    input[28] = -85;
    input[29] = -93;
    input[30] = 36;
    input[31] = 12;
    input[32] = -83;
    input[33] = 69;
    input[34] = 67;
    input[35] = 82;
    input[36] = -1;
    input[37] = -100;
    input[38] = -8;
    input[39] = 67;
    input[40] = 63;
    input[41] = 23;
    if (process(&input, 42) != 100) {
        return 1;
    }
    return 0;
}
