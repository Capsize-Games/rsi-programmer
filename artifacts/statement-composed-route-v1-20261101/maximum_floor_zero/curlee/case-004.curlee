fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 26;
    input[1] = -4;
    input[2] = 55;
    input[3] = 53;
    input[4] = -70;
    input[5] = -16;
    input[6] = -62;
    input[7] = 53;
    input[8] = -68;
    input[9] = -41;
    input[10] = 30;
    input[11] = -63;
    input[12] = 85;
    input[13] = 33;
    input[14] = 85;
    input[15] = 39;
    input[16] = -87;
    input[17] = 71;
    input[18] = 55;
    input[19] = 61;
    input[20] = 81;
    input[21] = -42;
    input[22] = -17;
    input[23] = 31;
    input[24] = -51;
    input[25] = -71;
    input[26] = 30;
    input[27] = -80;
    input[28] = -33;
    input[29] = 73;
    input[30] = 90;
    if (process(&input, 31) != 90) {
        return 1;
    }
    return 0;
}
