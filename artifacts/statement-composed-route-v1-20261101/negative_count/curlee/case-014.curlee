fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -1;
    input[1] = 64;
    input[2] = 58;
    input[3] = 32;
    input[4] = -16;
    input[5] = 65;
    input[6] = -41;
    input[7] = -4;
    input[8] = -72;
    input[9] = -50;
    input[10] = -100;
    input[11] = -27;
    input[12] = 18;
    input[13] = 29;
    input[14] = 51;
    input[15] = -29;
    input[16] = 85;
    input[17] = 11;
    input[18] = -34;
    input[19] = 25;
    input[20] = 20;
    input[21] = 80;
    input[22] = -40;
    input[23] = -40;
    input[24] = 40;
    input[25] = 73;
    input[26] = -48;
    input[27] = -86;
    input[28] = -55;
    input[29] = 100;
    input[30] = 91;
    input[31] = 66;
    input[32] = 53;
    input[33] = -57;
    input[34] = -24;
    input[35] = 96;
    input[36] = 56;
    input[37] = 48;
    input[38] = -22;
    input[39] = -25;
    if (process(&input, 40) != 19) {
        return 1;
    }
    return 0;
}
