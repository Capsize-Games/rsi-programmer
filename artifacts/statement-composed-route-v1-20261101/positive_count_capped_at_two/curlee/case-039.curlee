    input[27] = -31;
    input[28] = 61;
    input[29] = 88;
    input[30] = -70;
    input[31] = 78;
    input[32] = -39;
    input[33] = -63;
    input[34] = -66;
    input[35] = -32;
    input[36] = -65;
    input[37] = -73;
    input[38] = -94;
    input[39] = 40;
    input[40] = -48;
    if (process(&input, 41) != 2) {
        return 1;
    }
    return 0;
}
