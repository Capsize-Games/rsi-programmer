    input[13] = -8;
    input[14] = 11;
    input[15] = -92;
    input[16] = -99;
    input[17] = -32;
    input[18] = -19;
    input[19] = 79;
    input[20] = -24;
    input[21] = -62;
    input[22] = 53;
    input[23] = 35;
    input[24] = 5;
    input[25] = 45;
