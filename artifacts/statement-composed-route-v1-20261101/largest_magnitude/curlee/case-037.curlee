fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 6;
    input[1] = 20;
    input[2] = 12;
    input[3] = 75;
    input[4] = 28;
    input[5] = 45;
    input[6] = 54;
    input[7] = -94;
    input[8] = -50;
    input[9] = 58;
    input[10] = -41;
    input[11] = 23;
    input[12] = -34;
    input[13] = 90;
    input[14] = -55;
    input[15] = 95;
    input[16] = 85;
    input[17] = -69;
    input[18] = -42;
    if (process(&input, 19) != 95) {
        return 1;
    }
    return 0;
}
