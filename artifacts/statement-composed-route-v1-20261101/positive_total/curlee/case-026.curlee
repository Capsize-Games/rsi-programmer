fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 3;
    input[1] = 77;
    input[2] = -66;
    input[3] = 73;
    input[4] = 33;
    input[5] = -91;
    input[6] = -12;
    input[7] = -51;
    input[8] = 65;
    input[9] = 30;
    input[10] = -95;
    input[11] = -83;
    input[12] = -27;
    input[13] = 97;
    input[14] = 60;
    input[15] = 100;
    input[16] = 21;
    input[17] = -90;
    input[18] = -64;
    input[19] = 66;
    input[20] = -16;
    input[21] = -4;
    if (process(&input, 22) != 625) {
        return 1;
    }
    return 0;
}
