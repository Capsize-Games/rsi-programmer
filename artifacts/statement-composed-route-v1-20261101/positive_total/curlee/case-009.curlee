fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -95;
    input[1] = 97;
    input[2] = -27;
    input[3] = -91;
    input[4] = -69;
    input[5] = -12;
    input[6] = -74;
    input[7] = 1;
    input[8] = 65;
    input[9] = 42;
    input[10] = 45;
    input[11] = 13;
    input[12] = -84;
    input[13] = 77;
    input[14] = -53;
    if (process(&input, 15) != 340) {
        return 1;
    }
    return 0;
}
