    input[11] = -91;
    input[12] = 3;
    input[13] = -93;
    input[14] = 81;
    input[15] = -34;
    input[16] = 40;
    input[17] = 93;
    input[18] = 19;
    input[19] = 5;
    input[20] = 39;
    input[21] = 64;
    input[22] = 75;
    input[23] = 99;
    input[24] = 27;
    input[25] = 99;
    input[26] = 89;
    input[27] = -45;
    input[28] = -18;
    input[29] = -85;
    input[30] = 78;
    input[31] = 58;
    input[32] = -29;
    input[33] = 71;
    input[34] = -93;
    input[35] = 65;
    input[36] = 2;
    if (process(&input, 37) != 51) {
        return 1;
    }
    return 0;
}
