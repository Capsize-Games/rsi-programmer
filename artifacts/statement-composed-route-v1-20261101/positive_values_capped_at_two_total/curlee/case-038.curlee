fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
        if (((value + -1) > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 15;
    input[1] = -90;
    input[2] = 96;
    input[3] = -55;
    input[4] = -87;
    input[5] = 75;
    input[6] = 20;
    input[7] = 31;
    input[8] = 64;
    input[9] = -29;
    input[10] = -85;
    input[11] = -78;
    input[12] = -20;
    input[13] = 10;
    input[14] = -77;
    input[15] = 75;
    input[16] = -63;
    input[17] = 78;
    if (process(&input, 18) != 18) {
        return 1;
    }
    return 0;
}
