fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 90;
    input[1] = 94;
    input[2] = -72;
    input[3] = 48;
    input[4] = -77;
    input[5] = 37;
    input[6] = 16;
    input[7] = -51;
    input[8] = -24;
    input[9] = 17;
    input[10] = -47;
    input[11] = -72;
    input[12] = -37;
    input[13] = -38;
    input[14] = 87;
    input[15] = 18;
    input[16] = -72;
    input[17] = -60;
    input[18] = 57;
    input[19] = -86;
    input[20] = 98;
    if (process(&input, 21) != 562) {
        return 1;
    }
    return 0;
}
