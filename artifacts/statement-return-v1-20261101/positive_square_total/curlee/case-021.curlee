fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 10;
    input[1] = -89;
    input[2] = 75;
    input[3] = 22;
    input[4] = 0;
    input[5] = 89;
    input[6] = 30;
    input[7] = 67;
    input[8] = -72;
    input[9] = -5;
    input[10] = 64;
    input[11] = -98;
    input[12] = -41;
    input[13] = 76;
    input[14] = -2;
    input[15] = -91;
    input[16] = 56;
    input[17] = 5;
    input[18] = -100;
    input[19] = 66;
    input[20] = -18;
    input[21] = -68;
    input[22] = -76;
    input[23] = -61;
    input[24] = 10;
    input[25] = -49;
    input[26] = -29;
    if (process(&input, 27) != 37008) {
        return 1;
    }
    return 0;
}
