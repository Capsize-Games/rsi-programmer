    input[9] = -86;
    input[10] = 47;
    input[11] = -98;
    input[12] = 90;
    input[13] = 2;
    input[14] = -23;
    input[15] = -41;
    input[16] = 21;
    input[17] = -90;
    input[18] = -88;
    input[19] = -37;
    input[20] = 37;
    input[21] = 7;
    input[22] = 97;
    input[23] = -95;
    input[24] = -3;
    input[25] = 95;
    input[26] = 75;
    input[27] = -10;
    input[28] = -89;
    input[29] = 63;
    if (process(&input, 30) != 47611) {
        return 1;
    }
    return 0;
}
