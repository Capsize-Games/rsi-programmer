fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((acc > value)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 63;
    input[1] = -68;
    input[2] = 31;
    input[3] = 57;
    input[4] = -59;
    input[5] = 10;
    input[6] = 9;
    input[7] = 18;
    input[8] = 63;
    input[9] = -91;
    input[10] = -75;
    input[11] = 100;
    input[12] = 10;
    if (process(&input, 13) != -91) {
        return 1;
    }
    return 0;
}
