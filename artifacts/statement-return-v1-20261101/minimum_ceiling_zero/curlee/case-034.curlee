fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((acc > value)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -14;
    input[1] = -18;
    input[2] = 83;
    input[3] = -3;
    input[4] = -68;
    input[5] = 82;
    input[6] = 31;
    input[7] = -62;
    input[8] = 83;
    input[9] = -57;
    input[10] = -43;
    input[11] = -82;
    input[12] = -31;
    input[13] = 76;
    input[14] = -60;
    input[15] = -11;
    input[16] = 41;
    input[17] = -98;
    input[18] = -66;
    input[19] = -51;
    input[20] = -69;
    input[21] = 73;
    input[22] = 6;
    input[23] = -52;
    input[24] = 72;
    input[25] = 97;
    input[26] = 57;
    input[27] = -64;
    input[28] = 30;
    input[29] = -67;
    input[30] = 9;
    input[31] = 6;
    input[32] = 74;
    input[33] = 97;
    input[34] = 86;
    input[35] = 11;
    input[36] = 62;
    input[37] = -43;
    input[38] = -6;
    input[39] = -59;
    input[40] = 32;
    if (process(&input, 41) != -98) {
        return 1;
    }
    return 0;
}
