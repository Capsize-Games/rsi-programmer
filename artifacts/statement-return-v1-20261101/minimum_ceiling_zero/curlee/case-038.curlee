fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((acc > value)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 76;
    input[1] = 21;
    input[2] = -3;
    input[3] = 17;
    input[4] = 36;
    input[5] = -43;
    input[6] = -71;
    input[7] = 62;
    input[8] = -33;
    input[9] = -22;
    input[10] = -55;
    input[11] = -18;
    input[12] = -25;
    input[13] = -6;
    input[14] = 4;
    input[15] = 40;
    input[16] = -55;
    input[17] = -69;
    input[18] = -65;
    input[19] = 78;
    input[20] = 42;
    input[21] = 59;
    input[22] = -86;
    input[23] = -63;
    input[24] = 21;
    if (process(&input, 25) != -86) {
        return 1;
    }
    return 0;
}
