fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = 2;
        }
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -68;
    input[1] = 54;
    input[2] = 85;
    input[3] = 15;
    input[4] = 40;
    input[5] = -99;
    input[6] = 5;
    input[7] = 8;
    input[8] = -9;
    input[9] = 94;
    input[10] = -91;
    input[11] = -51;
    input[12] = 12;
    input[13] = 13;
    input[14] = -81;
    input[15] = 77;
    input[16] = -16;
    input[17] = -91;
    if (process(&input, 18) != 8) {
        return 1;
    }
    return 0;
}
