fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = 2;
        }
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -42;
    input[1] = -50;
    input[2] = -68;
    input[3] = -76;
    input[4] = 75;
    input[5] = 45;
    input[6] = -99;
    input[7] = 70;
    input[8] = 90;
    input[9] = -48;
    input[10] = -4;
    input[11] = -26;
    input[12] = 14;
    input[13] = 66;
    input[14] = -5;
    input[15] = -14;
    input[16] = -87;
    input[17] = 81;
    input[18] = 81;
    input[19] = -17;
    input[20] = -11;
    input[21] = -1;
    input[22] = -55;
    input[23] = 53;
    input[24] = 55;
    input[25] = 71;
    input[26] = 11;
    input[27] = 48;
    input[28] = -67;
    input[29] = 10;
    input[30] = -30;
    input[31] = 75;
    input[32] = -56;
    input[33] = -24;
    input[34] = 45;
    input[35] = 83;
    input[36] = -60;
    input[37] = 16;
    input[38] = -90;
    input[39] = 19;
    input[40] = -43;
    if (process(&input, 41) != 22) {
        return 1;
    }
    return 0;
}
