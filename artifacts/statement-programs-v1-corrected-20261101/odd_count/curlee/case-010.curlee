    input[12] = -76;
    input[13] = -15;
    input[14] = 52;
    input[15] = 77;
    input[16] = -27;
    input[17] = -46;
    input[18] = 69;
    input[19] = 80;
    input[20] = -36;
    input[21] = 65;
    input[22] = 78;
    input[23] = -57;
    input[24] = 73;
    input[25] = 98;
    input[26] = -63;
    input[27] = 91;
    input[28] = -92;
    input[29] = -70;
    input[30] = 1;
    input[31] = 89;
    input[32] = 33;
    input[33] = -65;
    input[34] = -77;
    input[35] = 38;
    input[36] = -24;
    if (process(&input, 37) != 21) {
        return 1;
    }
    return 0;
}
