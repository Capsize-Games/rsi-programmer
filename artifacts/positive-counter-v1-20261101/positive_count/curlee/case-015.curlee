fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -41;
    input[1] = -43;
    input[2] = 92;
    input[3] = 83;
    input[4] = -32;
    input[5] = -27;
    input[6] = -30;
    input[7] = -36;
    input[8] = 25;
    input[9] = 60;
    input[10] = 42;
    input[11] = 90;
    input[12] = 25;
    input[13] = -71;
    input[14] = -39;
    input[15] = 21;
    input[16] = 4;
    input[17] = 80;
    if (process(&input, 18) != 10) {
        return 1;
    }
    return 0;
}
