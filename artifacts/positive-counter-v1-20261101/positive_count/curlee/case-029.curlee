fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 74;
    input[1] = -33;
    input[2] = 18;
    input[3] = 37;
    input[4] = 23;
    input[5] = -93;
    input[6] = -51;
    input[7] = 58;
    input[8] = -4;
    input[9] = 70;
    input[10] = 6;
    input[11] = 75;
    input[12] = -81;
    input[13] = 3;
    input[14] = 52;
    if (process(&input, 15) != 10) {
        return 1;
    }
    return 0;
}
