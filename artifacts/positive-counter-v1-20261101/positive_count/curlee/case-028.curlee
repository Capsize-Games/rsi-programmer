fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 43;
    input[1] = 40;
    input[2] = 33;
    input[3] = 10;
    input[4] = -85;
    input[5] = 51;
    input[6] = -96;
    input[7] = -53;
    input[8] = 3;
    input[9] = -77;
    input[10] = 24;
    input[11] = 37;
    input[12] = -7;
    input[13] = -96;
    input[14] = 0;
    input[15] = -65;
    input[16] = 85;
    input[17] = 56;
    input[18] = -57;
    input[19] = -66;
    input[20] = -40;
    input[21] = 43;
    input[22] = -71;
    input[23] = -70;
    input[24] = -26;
    input[25] = 14;
    input[26] = -70;
    input[27] = 44;
    input[28] = 12;
    if (process(&input, 29) != 14) {
        return 1;
    }
    return 0;
}
