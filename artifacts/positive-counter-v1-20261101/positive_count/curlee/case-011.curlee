fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -14;
    input[1] = 53;
    input[2] = -90;
    input[3] = -66;
    input[4] = -69;
    input[5] = 68;
    input[6] = 62;
    input[7] = -43;
    input[8] = 14;
    input[9] = -91;
    input[10] = 38;
    input[11] = -35;
    input[12] = 52;
    input[13] = 25;
    input[14] = -100;
    input[15] = 46;
    input[16] = -60;
    input[17] = 20;
    input[18] = 46;
    input[19] = 80;
    input[20] = 95;
    input[21] = 8;
    input[22] = -23;
    input[23] = -24;
    input[24] = -1;
    input[25] = -11;
    input[26] = 33;
    input[27] = -35;
    input[28] = -23;
    input[29] = 2;
    if (process(&input, 30) != 15) {
        return 1;
    }
    return 0;
}
