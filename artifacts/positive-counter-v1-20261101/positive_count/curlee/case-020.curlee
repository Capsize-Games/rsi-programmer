fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -27;
    input[1] = 76;
    input[2] = -94;
    input[3] = -26;
    input[4] = 71;
    input[5] = 8;
    input[6] = -6;
    input[7] = -80;
    input[8] = -29;
    input[9] = 1;
    input[10] = -75;
    input[11] = 11;
    input[12] = -13;
    input[13] = -17;
    input[14] = 80;
    input[15] = 16;
    input[16] = 38;
    input[17] = -27;
    input[18] = -55;
    input[19] = -28;
    input[20] = -51;
    input[21] = -53;
    input[22] = 56;
    input[23] = 48;
    input[24] = 96;
    input[25] = 89;
    input[26] = 7;
    input[27] = 52;
    input[28] = -35;
    input[29] = 38;
    if (process(&input, 30) != 15) {
        return 1;
    }
    return 0;
}
