fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -55;
    input[1] = -10;
    input[2] = 32;
    input[3] = 48;
    input[4] = 72;
    input[5] = 19;
    input[6] = -94;
    input[7] = 83;
    input[8] = -8;
    input[9] = 94;
    input[10] = -96;
    input[11] = -12;
    input[12] = 67;
    input[13] = -88;
    input[14] = -66;
    input[15] = 17;
    input[16] = -57;
    input[17] = 42;
    input[18] = -54;
    input[19] = 0;
    if (process(&input, 20) != 9) {
        return 1;
    }
    return 0;
}
