fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 20;
    input[1] = -49;
    input[2] = 98;
    input[3] = 64;
    input[4] = 2;
    input[5] = -54;
    input[6] = 34;
    input[7] = 20;
    input[8] = -28;
    input[9] = -41;
    input[10] = 49;
    input[11] = -88;
    input[12] = -14;
    input[13] = 29;
    input[14] = 61;
    input[15] = 67;
    input[16] = 63;
    input[17] = -2;
    input[18] = -75;
    input[19] = -2;
    input[20] = 85;
    if (process(&input, 21) != 12) {
        return 1;
    }
    return 0;
}
