fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -68;
    input[1] = -78;
    input[2] = -28;
    input[3] = -64;
    input[4] = 56;
    input[5] = -73;
    input[6] = -19;
    input[7] = -91;
    input[8] = 29;
    input[9] = -67;
    input[10] = 0;
    input[11] = 72;
    input[12] = -18;
    input[13] = 58;
    input[14] = -57;
    input[15] = 38;
    input[16] = -31;
    input[17] = 15;
    input[18] = -90;
    input[19] = -2;
    input[20] = -33;
    input[21] = 93;
    if (process(&input, 22) != 7) {
        return 1;
    }
    return 0;
}
