    input[10] = -47;
    input[11] = 90;
    input[12] = 32;
    input[13] = -54;
    input[14] = -27;
    input[15] = -39;
    input[16] = -80;
    input[17] = 82;
    input[18] = 66;
    input[19] = 15;
    input[20] = 97;
    input[21] = -6;
    input[22] = -55;
    input[23] = 24;
    input[24] = -31;
    input[25] = 55;
    input[26] = -44;
    input[27] = -13;
    input[28] = 44;
    input[29] = -89;
    input[30] = 77;
    input[31] = 38;
    input[32] = 7;
    input[33] = 85;
    input[34] = 44;
    input[35] = 43;
    input[36] = -13;
    input[37] = -2;
    input[38] = -66;
    input[39] = -55;
    input[40] = -77;
    input[41] = 80;
    input[42] = 42;
    if (process(&input, 43) != 23) {
        return 1;
    }
    return 0;
}
