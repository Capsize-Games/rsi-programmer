fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
        if (((value - 2) > 0)) {
            acc = (acc - (value - 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -63;
    input[1] = -80;
    input[2] = -93;
    input[3] = 37;
    input[4] = -38;
    input[5] = 73;
    input[6] = 4;
    input[7] = -25;
    input[8] = -94;
    input[9] = -35;
    input[10] = -45;
    input[11] = 35;
    input[12] = -17;
    input[13] = -15;
    input[14] = 26;
    input[15] = -40;
    input[16] = 23;
    input[17] = -82;
    input[18] = -72;
    if (process(&input, 19) != 12) {
        return 1;
    }
    return 0;
}
