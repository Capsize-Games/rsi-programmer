fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
        if (((value - 2) > 0)) {
            acc = (acc - (value - 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -67;
    input[1] = 22;
    input[2] = 54;
    input[3] = -48;
    input[4] = 31;
    input[5] = 99;
    input[6] = -51;
    input[7] = 46;
    input[8] = -62;
    input[9] = 89;
    input[10] = 45;
    input[11] = -16;
    input[12] = 98;
    input[13] = 16;
    input[14] = -91;
    input[15] = -61;
    input[16] = 7;
    input[17] = -100;
    input[18] = -68;
    input[19] = 67;
    input[20] = 25;
    input[21] = -65;
    input[22] = -23;
    input[23] = -78;
    input[24] = -87;
    input[25] = 76;
    input[26] = -59;
    input[27] = -23;
    input[28] = 31;
    input[29] = 98;
    input[30] = 93;
    input[31] = -11;
    input[32] = 40;
    if (process(&input, 33) != 34) {
        return 1;
    }
    return 0;
}
