fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
        if (((value - 2) > 0)) {
            acc = (acc - (value - 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 21;
    input[1] = 39;
    input[2] = -76;
    input[3] = 31;
    input[4] = 98;
    input[5] = 65;
    input[6] = 36;
    input[7] = -44;
    input[8] = -47;
    input[9] = 99;
    input[10] = 63;
    input[11] = 50;
    input[12] = -86;
    input[13] = -18;
    input[14] = 96;
    input[15] = -58;
    input[16] = 77;
    input[17] = 3;
    input[18] = 3;
    input[19] = -16;
    input[20] = 83;
    input[21] = 34;
    input[22] = 24;
    input[23] = 34;
    input[24] = -99;
    input[25] = 99;
    input[26] = -27;
    input[27] = -52;
    if (process(&input, 28) != 36) {
        return 1;
    }
    return 0;
}
