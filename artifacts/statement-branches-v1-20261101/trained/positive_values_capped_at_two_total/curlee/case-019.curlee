fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
        if (((value - 2) > 0)) {
            acc = (acc - (value - 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -91;
    input[1] = -67;
    input[2] = 59;
    input[3] = 35;
    input[4] = 31;
    input[5] = 56;
    input[6] = -62;
    input[7] = -79;
    input[8] = 71;
    input[9] = -14;
    input[10] = 25;
    input[11] = 22;
    input[12] = 22;
    input[13] = -14;
    input[14] = -89;
    input[15] = -48;
    input[16] = 15;
    input[17] = -62;
    input[18] = 51;
    input[19] = 58;
    input[20] = -69;
    input[21] = 27;
    input[22] = 41;
    input[23] = 34;
    input[24] = -24;
    input[25] = 27;
    input[26] = -11;
    input[27] = -74;
    input[28] = -5;
    input[29] = 31;
    input[30] = -54;
    input[31] = -77;
    input[32] = 22;
    input[33] = -74;
    if (process(&input, 34) != 34) {
        return 1;
    }
    return 0;
}
