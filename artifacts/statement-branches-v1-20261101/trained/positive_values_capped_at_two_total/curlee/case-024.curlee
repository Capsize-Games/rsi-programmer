fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
        if (((value - 2) > 0)) {
            acc = (acc - (value - 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -43;
    input[1] = -48;
    input[2] = 67;
    input[3] = 26;
    input[4] = -47;
    input[5] = -68;
    input[6] = -25;
    input[7] = -47;
    input[8] = -7;
    input[9] = -60;
    input[10] = 82;
    input[11] = 21;
    input[12] = 83;
    input[13] = -99;
    input[14] = 80;
    input[15] = 63;
    input[16] = 37;
    input[17] = 7;
    input[18] = 63;
    input[19] = -18;
    input[20] = -35;
    input[21] = 85;
    input[22] = -14;
    input[23] = 57;
    input[24] = -74;
    input[25] = 4;
    input[26] = 90;
    input[27] = 33;
    input[28] = 73;
    input[29] = 2;
    input[30] = -53;
    input[31] = -69;
    if (process(&input, 32) != 34) {
        return 1;
    }
    return 0;
}
