fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
        if (((value - 2) > 0)) {
            acc = (acc - (value - 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 58;
    input[1] = 14;
    input[2] = 6;
    input[3] = 81;
    input[4] = 40;
    input[5] = -64;
    input[6] = 74;
    input[7] = -8;
    input[8] = 10;
    input[9] = 81;
    input[10] = 89;
    input[11] = 89;
    input[12] = 11;
    input[13] = -92;
    input[14] = -90;
    input[15] = 6;
    input[16] = -84;
    input[17] = 74;
    input[18] = 84;
    input[19] = 45;
    input[20] = 16;
    input[21] = -41;
    input[22] = -96;
    input[23] = -88;
    input[24] = 56;
    input[25] = 1;
    input[26] = -34;
    input[27] = -46;
    input[28] = 58;
    if (process(&input, 29) != 37) {
        return 1;
    }
    return 0;
}
