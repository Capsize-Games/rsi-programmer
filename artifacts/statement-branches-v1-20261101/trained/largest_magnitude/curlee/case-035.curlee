fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 0;
    input[1] = 53;
    input[2] = 78;
    input[3] = 65;
    input[4] = 90;
    input[5] = 99;
    input[6] = -23;
    input[7] = -9;
    input[8] = -23;
    input[9] = -9;
    input[10] = 63;
    input[11] = 13;
    input[12] = 97;
    input[13] = -97;
    input[14] = -11;
    input[15] = 52;
    input[16] = 49;
    input[17] = -25;
    if (process(&input, 18) != 99) {
        return 1;
    }
    return 0;
}
