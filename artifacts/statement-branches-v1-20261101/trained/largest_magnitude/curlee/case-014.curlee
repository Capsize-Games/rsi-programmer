fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if (((0 - value) > acc)) {
            acc = (0 - value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 4;
    input[1] = -59;
    input[2] = -70;
    input[3] = -2;
    input[4] = 34;
    input[5] = 6;
    input[6] = 10;
    input[7] = -8;
    input[8] = -30;
    input[9] = -47;
    input[10] = 3;
    input[11] = -89;
    input[12] = 42;
    if (process(&input, 13) != 89) {
        return 1;
    }
    return 0;
}
