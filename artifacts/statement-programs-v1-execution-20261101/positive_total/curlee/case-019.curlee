fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -18;
    input[1] = 44;
    input[2] = -57;
    input[3] = 14;
    input[4] = -83;
    input[5] = -82;
    input[6] = 44;
    input[7] = -56;
    input[8] = 9;
    input[9] = 78;
    input[10] = 90;
    input[11] = -83;
    input[12] = -10;
    input[13] = -23;
    input[14] = -42;
    input[15] = -68;
    input[16] = -68;
    input[17] = -79;
    if (process(&input, 18) != 279) {
        return 1;
    }
    return 0;
}
