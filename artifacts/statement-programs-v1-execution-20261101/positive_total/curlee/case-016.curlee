fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 8;
    input[1] = 27;
    input[2] = -78;
    input[3] = 98;
    input[4] = -70;
    input[5] = -79;
    input[6] = -28;
    input[7] = -63;
    input[8] = -16;
    input[9] = 11;
    input[10] = -78;
    input[11] = 89;
    input[12] = 15;
    if (process(&input, 13) != 248) {
        return 1;
    }
    return 0;
}
