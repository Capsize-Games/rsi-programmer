fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 42;
    input[1] = 58;
    input[2] = 9;
    input[3] = -45;
    input[4] = 92;
    input[5] = 65;
    input[6] = 60;
    input[7] = -49;
    input[8] = 85;
    input[9] = 63;
    input[10] = -73;
    input[11] = 36;
    input[12] = -44;
    input[13] = 15;
    input[14] = 42;
    input[15] = -83;
    input[16] = 65;
    if (process(&input, 17) != 632) {
        return 1;
    }
    return 0;
}
