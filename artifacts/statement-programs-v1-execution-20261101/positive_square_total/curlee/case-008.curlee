fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 22;
    input[1] = -82;
    input[2] = 46;
    input[3] = 50;
    input[4] = -71;
    input[5] = -5;
    input[6] = 11;
    input[7] = -33;
    input[8] = -57;
    input[9] = -92;
    input[10] = -81;
    input[11] = -32;
    input[12] = 99;
    input[13] = 7;
    input[14] = 84;
    input[15] = 70;
    input[16] = 6;
    input[17] = -65;
    if (process(&input, 18) != 27063) {
        return 1;
    }
    return 0;
}
