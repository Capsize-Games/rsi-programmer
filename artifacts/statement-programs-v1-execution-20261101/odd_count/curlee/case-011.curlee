fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((value % 2) != 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 21;
    input[1] = -86;
    input[2] = -11;
    input[3] = -60;
    input[4] = 36;
    input[5] = 37;
    input[6] = -56;
    input[7] = 14;
    input[8] = -68;
    input[9] = -32;
    input[10] = -93;
    input[11] = 50;
    input[12] = -41;
    input[13] = 57;
    input[14] = -40;
    input[15] = 33;
    input[16] = -22;
    input[17] = 30;
    input[18] = -36;
    input[19] = -7;
    input[20] = 28;
    input[21] = -40;
    input[22] = 45;
    if (process(&input, 23) != 9) {
        return 1;
    }
    return 0;
}
