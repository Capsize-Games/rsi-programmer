fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = 2;
        }
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -56;
    input[1] = -62;
    input[2] = 28;
    input[3] = 25;
    input[4] = 18;
    input[5] = 70;
    input[6] = -12;
    input[7] = -24;
    input[8] = 53;
    input[9] = -78;
    input[10] = 30;
    input[11] = 32;
    if (process(&input, 12) != 5) {
        return 1;
    }
    return 0;
}
