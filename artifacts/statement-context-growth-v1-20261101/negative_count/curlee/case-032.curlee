fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -18;
    input[1] = -29;
    input[2] = -2;
    input[3] = 79;
    input[4] = -80;
    input[5] = -23;
    input[6] = -100;
    input[7] = 53;
    input[8] = -57;
    input[9] = 97;
    input[10] = 63;
    input[11] = 62;
    input[12] = -84;
    input[13] = -4;
    input[14] = -87;
    input[15] = 53;
    if (process(&input, 16) != 10) {
        return 1;
    }
    return 0;
}
