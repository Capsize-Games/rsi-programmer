fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 61;
    input[1] = 59;
    input[2] = -6;
    input[3] = -89;
    input[4] = 78;
    input[5] = 6;
    input[6] = 20;
    input[7] = 68;
    input[8] = -6;
    input[9] = -36;
    input[10] = -68;
    input[11] = -58;
    input[12] = 60;
    input[13] = -13;
    input[14] = -56;
    input[15] = 33;
    input[16] = -24;
    input[17] = -36;
    input[18] = 9;
    input[19] = 83;
    if (process(&input, 20) != 10) {
        return 1;
    }
    return 0;
}
