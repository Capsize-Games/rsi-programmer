fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 88;
    input[1] = 95;
    input[2] = -99;
    input[3] = 8;
    input[4] = 37;
    input[5] = 76;
    input[6] = 20;
    input[7] = 69;
    input[8] = 56;
    input[9] = 97;
    input[10] = -26;
    input[11] = -88;
    input[12] = -9;
    input[13] = -38;
    input[14] = 15;
    input[15] = 43;
    input[16] = -40;
    input[17] = -86;
    input[18] = 70;
    input[19] = 88;
    if (process(&input, 20) != 7) {
        return 1;
    }
    return 0;
}
