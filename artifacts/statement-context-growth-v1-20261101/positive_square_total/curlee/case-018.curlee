    input[15] = -32;
    input[16] = 83;
    input[17] = 1;
    input[18] = -6;
    input[19] = 38;
    input[20] = 9;
    input[21] = 26;
    input[22] = -95;
    input[23] = -61;
    input[24] = 73;
    input[25] = -11;
    input[26] = -79;
    input[27] = 21;
    input[28] = -69;
    input[29] = 70;
    input[30] = 63;
    input[31] = 87;
    input[32] = 2;
    input[33] = 73;
    input[34] = 84;
    input[35] = 65;
    if (process(&input, 36) != 81701) {
        return 1;
    }
    return 0;
}
