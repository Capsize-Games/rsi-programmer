fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -44;
    input[1] = -43;
    input[2] = 91;
    input[3] = 51;
    input[4] = -45;
    input[5] = -37;
    input[6] = -82;
    input[7] = -43;
    input[8] = 54;
    input[9] = 35;
    input[10] = -7;
    input[11] = 76;
    input[12] = 55;
    input[13] = 49;
    input[14] = 44;
    input[15] = 1;
    input[16] = 10;
    input[17] = -43;
    input[18] = -6;
    input[19] = -100;
    input[20] = -15;
    input[21] = 88;
    input[22] = -20;
    input[23] = -3;
    input[24] = 86;
    if (process(&input, 25) != 43402) {
        return 1;
    }
    return 0;
}
