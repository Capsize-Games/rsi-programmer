fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((acc - value) > 1)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 99;
    input[1] = 16;
    input[2] = -40;
    input[3] = -85;
    input[4] = 20;
    input[5] = 58;
    input[6] = 33;
    input[7] = -3;
    input[8] = -57;
    input[9] = -37;
    input[10] = 75;
    input[11] = 35;
    input[12] = 42;
    input[13] = 91;
    input[14] = 34;
    input[15] = 16;
    input[16] = 88;
    input[17] = -75;
    input[18] = 67;
    input[19] = 20;
    input[20] = 95;
    if (process(&input, 21) != -85) {
        return 1;
    }
    return 0;
}
