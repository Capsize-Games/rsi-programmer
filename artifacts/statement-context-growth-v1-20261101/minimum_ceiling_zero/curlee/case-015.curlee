    input[11] = 41;
    input[12] = -7;
    input[13] = 41;
    input[14] = 65;
    input[15] = -99;
    input[16] = -45;
    input[17] = -99;
    input[18] = -93;
    input[19] = -32;
    input[20] = -62;
    input[21] = 95;
    input[22] = 70;
    input[23] = 53;
    input[24] = -81;
    input[25] = -24;
    input[26] = 58;
    input[27] = 72;
    input[28] = -80;
    input[29] = 19;
    input[30] = 4;
    input[31] = 97;
    input[32] = -64;
    input[33] = -60;
    input[34] = -6;
    input[35] = -54;
    input[36] = 21;
    input[37] = -27;
    input[38] = 41;
    if (process(&input, 39) != -100) {
        return 1;
    }
    return 0;
}
