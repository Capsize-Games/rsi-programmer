fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -53;
    input[1] = 21;
    input[2] = 78;
    input[3] = 81;
    input[4] = -60;
    input[5] = 76;
    input[6] = -8;
    input[7] = 45;
    input[8] = 19;
    input[9] = 0;
    input[10] = -50;
    input[11] = 92;
    input[12] = 23;
    input[13] = -28;
    input[14] = 42;
    input[15] = 53;
    input[16] = -32;
    input[17] = 0;
    input[18] = -61;
    input[19] = -46;
    input[20] = 97;
    input[21] = -46;
    input[22] = -85;
    input[23] = -51;
    input[24] = 80;
    input[25] = 21;
    input[26] = 20;
    input[27] = -59;
    input[28] = -70;
    input[29] = 48;
    input[30] = 3;
    input[31] = 98;
    input[32] = -32;
    input[33] = -63;
    input[34] = 97;
    if (process(&input, 35) != 994) {
        return 1;
    }
    return 0;
}
