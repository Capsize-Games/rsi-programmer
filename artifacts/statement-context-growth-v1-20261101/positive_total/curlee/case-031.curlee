    input[11] = 74;
    input[12] = 37;
    input[13] = -28;
    input[14] = 37;
    input[15] = -46;
    input[16] = 25;
    input[17] = 69;
    input[18] = -18;
    input[19] = -84;
    input[20] = 86;
    input[21] = -71;
    input[22] = -54;
    input[23] = 88;
    input[24] = 57;
    input[25] = -15;
    input[26] = 6;
    input[27] = 28;
    input[28] = -78;
    input[29] = 81;
    input[30] = 54;
    input[31] = -14;
    input[32] = -70;
    input[33] = 100;
    input[34] = -1;
    input[35] = 53;
    if (process(&input, 36) != 1099) {
        return 1;
    }
    return 0;
}
