    input[10] = -39;
    input[11] = 11;
    input[12] = -29;
    input[13] = 66;
    input[14] = -17;
    input[15] = -46;
    input[16] = -45;
    input[17] = 22;
    input[18] = -79;
    input[19] = -86;
    input[20] = 68;
    input[21] = 46;
    input[22] = 82;
    input[23] = -82;
    input[24] = -65;
    input[25] = 13;
    input[26] = -33;
    input[27] = 57;
    input[28] = 86;
    input[29] = 58;
    input[30] = -49;
    input[31] = -87;
    input[32] = -27;
    input[33] = -64;
    input[34] = 20;
    input[35] = 76;
    input[36] = -42;
    input[37] = 82;
    input[38] = -42;
    input[39] = 76;
    input[40] = 52;
    if (process(&input, 41) != 86) {
        return 1;
    }
    return 0;
}
