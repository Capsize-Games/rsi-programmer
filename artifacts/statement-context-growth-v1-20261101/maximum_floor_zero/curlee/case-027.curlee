fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((value - 0) > acc)) {
            acc = value;
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -23;
    input[1] = -92;
    input[2] = 38;
    input[3] = -71;
    input[4] = -79;
    input[5] = 76;
    input[6] = 83;
    input[7] = -48;
    input[8] = -37;
    input[9] = -63;
    input[10] = 96;
    input[11] = -90;
    input[12] = -65;
    input[13] = 90;
    input[14] = -34;
    input[15] = 75;
    input[16] = -18;
    if (process(&input, 17) != 96) {
        return 1;
    }
    return 0;
}
