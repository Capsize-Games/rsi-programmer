fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if (((value + value) <= value)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = value;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -6;
    input[1] = -6;
    input[2] = -5;
    input[3] = -4;
    input[4] = -1;
    input[5] = -3;
    input[6] = -3;
    input[7] = 2;
    if (process(&input, 8, &mut output) != 7) { return 1; }
    if (output[0] != -6) { return 1; }
    if (output[1] != -6) { return 1; }
    if (output[2] != -5) { return 1; }
    if (output[3] != -4) { return 1; }
    if (output[4] != -1) { return 1; }
    if (output[5] != -3) { return 1; }
    if (output[6] != -3) { return 1; }
    return 0;
}
