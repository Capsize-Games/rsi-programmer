fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((0 < value)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = (outlen + value);
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = 3;
    input[1] = -1;
    input[2] = -4;
    input[3] = 5;
    input[4] = 4;
    input[5] = -4;
    input[6] = -2;
    input[7] = 6;
    input[8] = -7;
    if (process(&input, 9, &mut output) != 0) { return 1; }
    return 0;
}
