fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = value;
            outlen = outlen + 1;
        }
        if ((value <= 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 0;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -86;
    input[1] = -86;
    input[2] = 13;
    input[3] = -35;
    input[4] = -73;
    input[5] = 25;
    input[6] = -86;
    input[7] = 60;
    input[8] = -62;
    input[9] = -24;
    input[10] = -41;
    input[11] = -20;
    input[12] = -45;
    input[13] = -18;
    input[14] = -100;
    input[15] = -18;
    input[16] = 81;
    input[17] = 74;
    input[18] = 13;
    input[19] = -1;
    if (process(&input, 20, &mut output) != 20) { return 1; }
    if (output[0] != 0) { return 1; }
    if (output[1] != 0) { return 1; }
    if (output[2] != 13) { return 1; }
    if (output[3] != 0) { return 1; }
    if (output[4] != 0) { return 1; }
    if (output[5] != 25) { return 1; }
    if (output[6] != 0) { return 1; }
    if (output[7] != 60) { return 1; }
    if (output[8] != 0) { return 1; }
    if (output[9] != 0) { return 1; }
    if (output[10] != 0) { return 1; }
    if (output[11] != 0) { return 1; }
    if (output[12] != 0) { return 1; }
    if (output[13] != 0) { return 1; }
    if (output[14] != 0) { return 1; }
    if (output[15] != 0) { return 1; }
    if (output[16] != 81) { return 1; }
    if (output[17] != 74) { return 1; }
    if (output[18] != 13) { return 1; }
    if (output[19] != 0) { return 1; }
    return 0;
}
