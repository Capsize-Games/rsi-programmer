fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = value;
            outlen = outlen + 1;
        }
        if ((value <= 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 0;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -19;
    input[1] = 24;
    input[2] = 7;
    input[3] = 54;
    input[4] = 78;
    input[5] = 55;
    input[6] = 0;
    input[7] = -77;
    input[8] = 92;
    input[9] = -58;
    input[10] = 80;
    input[11] = 14;
    input[12] = -24;
    input[13] = -98;
    input[14] = -10;
    input[15] = 71;
    input[16] = 100;
    input[17] = 67;
    input[18] = -55;
    input[19] = 100;
    input[20] = -13;
    if (process(&input, 21, &mut output) != 21) { return 1; }
    if (output[0] != 0) { return 1; }
    if (output[1] != 24) { return 1; }
    if (output[2] != 7) { return 1; }
    if (output[3] != 54) { return 1; }
    if (output[4] != 78) { return 1; }
    if (output[5] != 55) { return 1; }
    if (output[6] != 0) { return 1; }
    if (output[7] != 0) { return 1; }
    if (output[8] != 92) { return 1; }
    if (output[9] != 0) { return 1; }
    if (output[10] != 80) { return 1; }
    if (output[11] != 14) { return 1; }
    if (output[12] != 0) { return 1; }
    if (output[13] != 0) { return 1; }
    if (output[14] != 0) { return 1; }
    if (output[15] != 71) { return 1; }
    if (output[16] != 100) { return 1; }
    if (output[17] != 67) { return 1; }
    if (output[18] != 0) { return 1; }
    if (output[19] != 100) { return 1; }
    if (output[20] != 0) { return 1; }
    return 0;
}
