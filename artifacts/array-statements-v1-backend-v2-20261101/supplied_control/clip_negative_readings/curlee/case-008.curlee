fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = value;
            outlen = outlen + 1;
        }
        if ((value <= 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 0;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -1;
    input[1] = 55;
    input[2] = 75;
    input[3] = 22;
    input[4] = 31;
    input[5] = 14;
    input[6] = -53;
    input[7] = 73;
    input[8] = 22;
    input[9] = 89;
    input[10] = -8;
    input[11] = -38;
    input[12] = -89;
    input[13] = -80;
    input[14] = -84;
    input[15] = 32;
    input[16] = -40;
    input[17] = 10;
    input[18] = -28;
    input[19] = 19;
    input[20] = 6;
    input[21] = -29;
    input[22] = 24;
    input[23] = -29;
    input[24] = -5;
    input[25] = -12;
    input[26] = 74;
    input[27] = -11;
    input[28] = 72;
    input[29] = 21;
    input[30] = 18;
    if (process(&input, 31, &mut output) != 31) { return 1; }
    if (output[0] != 0) { return 1; }
    if (output[1] != 55) { return 1; }
    if (output[2] != 75) { return 1; }
    if (output[3] != 22) { return 1; }
    if (output[4] != 31) { return 1; }
    if (output[5] != 14) { return 1; }
    if (output[6] != 0) { return 1; }
    if (output[7] != 73) { return 1; }
    if (output[8] != 22) { return 1; }
    if (output[9] != 89) { return 1; }
    if (output[10] != 0) { return 1; }
    if (output[11] != 0) { return 1; }
    if (output[12] != 0) { return 1; }
    if (output[13] != 0) { return 1; }
    if (output[14] != 0) { return 1; }
    if (output[15] != 32) { return 1; }
    if (output[16] != 0) { return 1; }
    if (output[17] != 10) { return 1; }
    if (output[18] != 0) { return 1; }
    if (output[19] != 19) { return 1; }
    if (output[20] != 6) { return 1; }
    if (output[21] != 0) { return 1; }
    if (output[22] != 24) { return 1; }
    if (output[23] != 0) { return 1; }
    if (output[24] != 0) { return 1; }
    if (output[25] != 0) { return 1; }
    if (output[26] != 74) { return 1; }
    if (output[27] != 0) { return 1; }
    if (output[28] != 72) { return 1; }
    if (output[29] != 21) { return 1; }
    if (output[30] != 18) { return 1; }
    return 0;
}
