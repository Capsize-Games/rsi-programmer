fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if ((value <= 2)) {
                if (outlen < 0 || outlen >= 512) { return -1; }
                output[outlen] = value;
                outlen = outlen + 1;
            }
        }
        if ((value > 2)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 2;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = 41;
    input[1] = -6;
    input[2] = 83;
    input[3] = 80;
    input[4] = -59;
    input[5] = 51;
    input[6] = -30;
    input[7] = 79;
    input[8] = 21;
    input[9] = -23;
    input[10] = 84;
    input[11] = -95;
    input[12] = -14;
    input[13] = 60;
    input[14] = -38;
    input[15] = 68;
    input[16] = 27;
    input[17] = -58;
    input[18] = 71;
    input[19] = 5;
    input[20] = -78;
    input[21] = 69;
    input[22] = 35;
    input[23] = -42;
    input[24] = -15;
    input[25] = -58;
    input[26] = -17;
    input[27] = 40;
    input[28] = 99;
    input[29] = -49;
    input[30] = -24;
    input[31] = -37;
    input[32] = -63;
    input[33] = -66;
    input[34] = -7;
    if (process(&input, 35, &mut output) != 16) { return 1; }
    if (output[0] != 2) { return 1; }
    if (output[1] != 2) { return 1; }
    if (output[2] != 2) { return 1; }
    if (output[3] != 2) { return 1; }
    if (output[4] != 2) { return 1; }
    if (output[5] != 2) { return 1; }
    if (output[6] != 2) { return 1; }
    if (output[7] != 2) { return 1; }
    if (output[8] != 2) { return 1; }
    if (output[9] != 2) { return 1; }
    if (output[10] != 2) { return 1; }
    if (output[11] != 2) { return 1; }
    if (output[12] != 2) { return 1; }
    if (output[13] != 2) { return 1; }
    if (output[14] != 2) { return 1; }
    if (output[15] != 2) { return 1; }
    return 0;
}
