fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if ((value <= 2)) {
                if (outlen < 0 || outlen >= 512) { return -1; }
                output[outlen] = value;
                outlen = outlen + 1;
            }
        }
        if ((value > 2)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 2;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = 78;
    input[1] = 47;
    input[2] = 92;
    input[3] = -53;
    input[4] = 1;
    input[5] = -2;
    input[6] = -40;
    input[7] = -22;
    input[8] = -80;
    input[9] = -52;
    input[10] = -58;
    input[11] = -48;
    input[12] = -53;
    input[13] = -95;
    input[14] = -32;
    input[15] = 34;
    input[16] = 78;
    input[17] = -59;
    input[18] = 73;
    input[19] = 73;
    input[20] = 45;
    input[21] = -88;
    input[22] = -9;
    input[23] = 1;
    if (process(&input, 24, &mut output) != 10) { return 1; }
    if (output[0] != 2) { return 1; }
    if (output[1] != 2) { return 1; }
    if (output[2] != 2) { return 1; }
    if (output[3] != 1) { return 1; }
    if (output[4] != 2) { return 1; }
    if (output[5] != 2) { return 1; }
    if (output[6] != 2) { return 1; }
    if (output[7] != 2) { return 1; }
    if (output[8] != 2) { return 1; }
    if (output[9] != 1) { return 1; }
    return 0;
}
