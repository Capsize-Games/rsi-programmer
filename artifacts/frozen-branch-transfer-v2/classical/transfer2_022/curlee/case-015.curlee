    input[11] = -24;
    input[12] = -4;
    input[13] = -73;
    input[14] = -79;
    input[15] = -16;
    input[16] = -63;
    input[17] = 8;
    input[18] = 56;
    input[19] = -81;
    input[20] = -72;
    input[21] = -5;
    input[22] = -37;
    input[23] = -71;
    input[24] = -36;
    input[25] = -47;
    input[26] = 79;
    input[27] = 8;
    input[28] = -46;
    input[29] = 3;
    input[30] = 86;
    input[31] = -52;
    input[32] = -28;
    input[33] = 72;
    input[34] = -19;
    if (process(&input, 35) != 37839) {
        return 1;
    }
    return 0;
}
