fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > acc)) {
            acc = value;
        }
        if ((value < 0)) {
            acc = (acc - 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 93;
    input[1] = 58;
    input[2] = -55;
    input[3] = 31;
    input[4] = 22;
    input[5] = -89;
    input[6] = -57;
    input[7] = 15;
    input[8] = -96;
    input[9] = -52;
    input[10] = -86;
    input[11] = 0;
    input[12] = -54;
    input[13] = -42;
    input[14] = 7;
    if (process(&input, 15) != 85) {
        return 1;
    }
    return 0;
}
