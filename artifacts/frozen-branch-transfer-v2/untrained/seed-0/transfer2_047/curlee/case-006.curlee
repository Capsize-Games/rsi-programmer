fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value <= acc)) {
            acc = value;
        }
        if ((((2 * 2) % 2) == 0)) {
            acc = (acc - (2 * 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -99;
    input[1] = 75;
    input[2] = 63;
    input[3] = -68;
    input[4] = 74;
    input[5] = -37;
    input[6] = 54;
    input[7] = -64;
    input[8] = 66;
    input[9] = 33;
    input[10] = -7;
    input[11] = 55;
    input[12] = 87;
    if (process(&input, 13) != -151) {
        return 1;
    }
    return 0;
}
