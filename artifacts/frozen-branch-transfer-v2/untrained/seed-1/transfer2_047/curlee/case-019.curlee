fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value <= acc)) {
            acc = value;
        }
        if ((((2 + 2) % 2) == 0)) {
            acc = (acc - (2 + 2));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 4;
    input[1] = -12;
    input[2] = 84;
    input[3] = -37;
    input[4] = -53;
    input[5] = -51;
    input[6] = -4;
    input[7] = 84;
    input[8] = -79;
    input[9] = 51;
    input[10] = 46;
    input[11] = -8;
    input[12] = -98;
    input[13] = -37;
    input[14] = -78;
    input[15] = 19;
    input[16] = 5;
    input[17] = -91;
    input[18] = 36;
    input[19] = -8;
    input[20] = -36;
    input[21] = -8;
    input[22] = -55;
    input[23] = 83;
    input[24] = -61;
    input[25] = -29;
    input[26] = -71;
    input[27] = -95;
    input[28] = -16;
    input[29] = 1;
    input[30] = 81;
    input[31] = 17;
    input[32] = 13;
    input[33] = -22;
    input[34] = 71;
    if (process(&input, 35) != -190) {
        return 1;
    }
    return 0;
}
