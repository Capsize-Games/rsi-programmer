fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 52;
    input[1] = -71;
    input[2] = 81;
    input[3] = -3;
    input[4] = 51;
    input[5] = 97;
    input[6] = -79;
    input[7] = -42;
    input[8] = 25;
    input[9] = -73;
    input[10] = -93;
    input[11] = -23;
    input[12] = -35;
    input[13] = -82;
    input[14] = 78;
    input[15] = -1;
    input[16] = 44;
    input[17] = -48;
    input[18] = -24;
    input[19] = -31;
    input[20] = -56;
    input[21] = -96;
    input[22] = 54;
    input[23] = -31;
    input[24] = -8;
    input[25] = 17;
    input[26] = -50;
    input[27] = 99;
    input[28] = -13;
    input[29] = -96;
    input[30] = 17;
    input[31] = -32;
    input[32] = 76;
    if (process(&input, 33) != 48991) {
        return 1;
    }
    return 0;
}
