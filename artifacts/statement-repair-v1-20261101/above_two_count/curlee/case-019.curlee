    input[9] = 71;
    input[10] = -33;
    input[11] = 8;
    input[12] = 84;
    input[13] = 55;
    input[14] = -79;
    input[15] = -64;
    input[16] = 35;
    input[17] = -37;
    input[18] = -54;
    input[19] = 1;
    input[20] = 75;
    input[21] = -83;
    input[22] = -32;
    input[23] = -59;
    input[24] = -99;
    input[25] = -14;
    input[26] = -99;
    input[27] = 64;
    input[28] = 68;
    input[29] = 9;
    input[30] = -70;
    input[31] = -91;
    input[32] = -15;
    input[33] = 48;
    input[34] = 65;
    input[35] = 34;
    input[36] = 82;
    if (process(&input, 37) != 18) {
        return 1;
    }
    return 0;
}
