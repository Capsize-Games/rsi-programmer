fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 2)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -19;
    input[1] = -29;
    input[2] = -100;
    input[3] = 59;
    input[4] = 8;
    input[5] = 21;
    input[6] = 17;
    input[7] = -86;
    input[8] = 95;
    input[9] = -11;
    input[10] = -73;
    input[11] = 50;
    input[12] = -37;
    input[13] = 35;
    input[14] = -12;
    input[15] = -83;
    input[16] = 3;
    input[17] = -8;
    input[18] = -22;
    input[19] = -98;
    input[20] = -3;
    input[21] = -51;
    input[22] = -75;
    input[23] = 11;
    input[24] = 3;
    input[25] = 15;
    input[26] = 92;
    input[27] = -67;
    input[28] = 68;
    input[29] = -52;
    input[30] = -93;
    input[31] = 57;
    if (process(&input, 32) != 14) {
        return 1;
    }
    return 0;
}
