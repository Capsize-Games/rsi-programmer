fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -98;
    input[1] = 23;
    input[2] = 98;
    input[3] = -66;
    input[4] = 87;
    input[5] = 19;
    input[6] = 70;
    input[7] = -45;
    input[8] = 95;
    input[9] = -27;
    input[10] = 21;
    input[11] = -84;
    input[12] = 91;
    input[13] = 93;
    input[14] = -22;
    input[15] = 87;
    input[16] = 72;
    input[17] = 13;
    input[18] = 97;
    input[19] = -92;
    input[20] = -71;
    input[21] = 16;
    input[22] = 13;
    input[23] = 50;
    input[24] = 27;
    input[25] = 61;
    input[26] = -4;
    input[27] = -24;
    input[28] = 94;
    input[29] = 87;
    input[30] = -8;
    input[31] = -16;
    input[32] = -12;
    if (process(&input, 33) != 1214) {
        return 1;
    }
    return 0;
}
