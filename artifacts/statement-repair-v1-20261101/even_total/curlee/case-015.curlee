fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((value % 2) == 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 89;
    input[1] = -55;
    input[2] = 47;
    input[3] = -40;
    input[4] = 35;
    input[5] = 67;
    input[6] = 7;
    input[7] = -3;
    input[8] = 35;
    input[9] = -63;
    input[10] = -8;
    input[11] = 59;
    input[12] = 4;
    input[13] = -70;
    input[14] = 8;
    input[15] = 7;
    input[16] = 68;
    input[17] = -14;
    input[18] = -91;
    input[19] = -59;
    input[20] = -60;
    input[21] = -13;
    if (process(&input, 22) != -112) {
        return 1;
    }
    return 0;
}
