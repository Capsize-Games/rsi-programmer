    input[34] = -20;
    input[35] = -39;
    input[36] = 90;
    input[37] = 91;
    input[38] = -85;
    if (process(&input, 39, &mut output) != 39) { return 1; }
    if (output[0] != 0) { return 1; }
    if (output[1] != 42) { return 1; }
    if (output[2] != 0) { return 1; }
    if (output[3] != 23) { return 1; }
    if (output[4] != 0) { return 1; }
    if (output[5] != 97) { return 1; }
    if (output[6] != 0) { return 1; }
    if (output[7] != 3) { return 1; }
    if (output[8] != 0) { return 1; }
    if (output[9] != 0) { return 1; }
    if (output[10] != 0) { return 1; }
    if (output[11] != 0) { return 1; }
    if (output[12] != 0) { return 1; }
    if (output[13] != 1) { return 1; }
    if (output[14] != 67) { return 1; }
    if (output[15] != 64) { return 1; }
    if (output[16] != 0) { return 1; }
    if (output[17] != 76) { return 1; }
    if (output[18] != 0) { return 1; }
    if (output[19] != 0) { return 1; }
    if (output[20] != 34) { return 1; }
    if (output[21] != 0) { return 1; }
    if (output[22] != 89) { return 1; }
    if (output[23] != 86) { return 1; }
    if (output[24] != 35) { return 1; }
    if (output[25] != 48) { return 1; }
    if (output[26] != 28) { return 1; }
    if (output[27] != 0) { return 1; }
    if (output[28] != 0) { return 1; }
    if (output[29] != 100) { return 1; }
    if (output[30] != 21) { return 1; }
    if (output[31] != 0) { return 1; }
    if (output[32] != 51) { return 1; }
    if (output[33] != 6) { return 1; }
    if (output[34] != 0) { return 1; }
    if (output[35] != 0) { return 1; }
    if (output[36] != 90) { return 1; }
    if (output[37] != 91) { return 1; }
    if (output[38] != 0) { return 1; }
    return 0;
}
