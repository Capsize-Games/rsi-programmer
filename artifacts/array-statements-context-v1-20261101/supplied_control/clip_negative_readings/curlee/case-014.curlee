fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = value;
            outlen = outlen + 1;
        }
        if ((value <= 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 0;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -99;
    input[1] = 87;
    input[2] = -44;
    input[3] = 84;
    input[4] = 53;
    input[5] = -36;
    input[6] = 6;
    input[7] = -95;
    input[8] = -90;
    input[9] = -75;
    input[10] = -35;
    input[11] = 66;
    input[12] = -87;
    input[13] = 59;
    input[14] = 27;
    input[15] = -29;
    input[16] = 85;
    if (process(&input, 17, &mut output) != 17) { return 1; }
    if (output[0] != 0) { return 1; }
    if (output[1] != 87) { return 1; }
    if (output[2] != 0) { return 1; }
    if (output[3] != 84) { return 1; }
    if (output[4] != 53) { return 1; }
    if (output[5] != 0) { return 1; }
    if (output[6] != 6) { return 1; }
    if (output[7] != 0) { return 1; }
    if (output[8] != 0) { return 1; }
    if (output[9] != 0) { return 1; }
    if (output[10] != 0) { return 1; }
    if (output[11] != 66) { return 1; }
    if (output[12] != 0) { return 1; }
    if (output[13] != 59) { return 1; }
    if (output[14] != 27) { return 1; }
    if (output[15] != 0) { return 1; }
    if (output[16] != 85) { return 1; }
    return 0;
}
