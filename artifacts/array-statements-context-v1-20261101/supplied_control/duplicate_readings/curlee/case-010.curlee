fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if (outlen < 0 || outlen >= 512) { return -1; }
        output[outlen] = value;
        outlen = outlen + 1;
        if (outlen < 0 || outlen >= 512) { return -1; }
        output[outlen] = value;
        outlen = outlen + 1;
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -53;
    input[1] = 36;
    input[2] = -33;
    input[3] = 17;
    input[4] = 71;
    input[5] = -24;
    input[6] = 54;
    input[7] = -47;
    input[8] = -80;
    input[9] = 32;
    input[10] = -90;
    input[11] = 24;
    input[12] = -1;
    input[13] = 23;
    input[14] = 39;
    input[15] = 5;
    input[16] = -76;
    input[17] = 75;
    input[18] = 31;
    input[19] = 13;
    if (process(&input, 20, &mut output) != 40) { return 1; }
    if (output[0] != -53) { return 1; }
    if (output[1] != -53) { return 1; }
    if (output[2] != 36) { return 1; }
    if (output[3] != 36) { return 1; }
    if (output[4] != -33) { return 1; }
    if (output[5] != -33) { return 1; }
    if (output[6] != 17) { return 1; }
    if (output[7] != 17) { return 1; }
    if (output[8] != 71) { return 1; }
    if (output[9] != 71) { return 1; }
    if (output[10] != -24) { return 1; }
    if (output[11] != -24) { return 1; }
    if (output[12] != 54) { return 1; }
    if (output[13] != 54) { return 1; }
    if (output[14] != -47) { return 1; }
    if (output[15] != -47) { return 1; }
    if (output[16] != -80) { return 1; }
    if (output[17] != -80) { return 1; }
    if (output[18] != 32) { return 1; }
    if (output[19] != 32) { return 1; }
    if (output[20] != -90) { return 1; }
    if (output[21] != -90) { return 1; }
    if (output[22] != 24) { return 1; }
    if (output[23] != 24) { return 1; }
    if (output[24] != -1) { return 1; }
    if (output[25] != -1) { return 1; }
    if (output[26] != 23) { return 1; }
    if (output[27] != 23) { return 1; }
    if (output[28] != 39) { return 1; }
    if (output[29] != 39) { return 1; }
    if (output[30] != 5) { return 1; }
    if (output[31] != 5) { return 1; }
    if (output[32] != -76) { return 1; }
    if (output[33] != -76) { return 1; }
    if (output[34] != 75) { return 1; }
    if (output[35] != 75) { return 1; }
    if (output[36] != 31) { return 1; }
    if (output[37] != 31) { return 1; }
    if (output[38] != 13) { return 1; }
    if (output[39] != 13) { return 1; }
    return 0;
}
