fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value < 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = (0 - value);
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -8;
    input[1] = 42;
    input[2] = -54;
    input[3] = 23;
    input[4] = -74;
    input[5] = 97;
    input[6] = -27;
    input[7] = 3;
    input[8] = -76;
    input[9] = -6;
    input[10] = -57;
    input[11] = -56;
    input[12] = -99;
    input[13] = 1;
    input[14] = 67;
    input[15] = 64;
    input[16] = -21;
    input[17] = 76;
    input[18] = -91;
    input[19] = -71;
    input[20] = 34;
    input[21] = -95;
    input[22] = 89;
    input[23] = 86;
    input[24] = 35;
    input[25] = 48;
    input[26] = 28;
    input[27] = -14;
    input[28] = -50;
    input[29] = 100;
    input[30] = 21;
    input[31] = -30;
    input[32] = 51;
    input[33] = 6;
    input[34] = -20;
    input[35] = -39;
    input[36] = 90;
    input[37] = 91;
    input[38] = -85;
    if (process(&input, 39, &mut output) != 19) { return 1; }
    if (output[0] != 8) { return 1; }
    if (output[1] != 54) { return 1; }
    if (output[2] != 74) { return 1; }
    if (output[3] != 27) { return 1; }
    if (output[4] != 76) { return 1; }
    if (output[5] != 6) { return 1; }
    if (output[6] != 57) { return 1; }
    if (output[7] != 56) { return 1; }
    if (output[8] != 99) { return 1; }
    if (output[9] != 21) { return 1; }
    if (output[10] != 91) { return 1; }
    if (output[11] != 71) { return 1; }
    if (output[12] != 95) { return 1; }
    if (output[13] != 14) { return 1; }
    if (output[14] != 50) { return 1; }
    if (output[15] != 30) { return 1; }
    if (output[16] != 20) { return 1; }
    if (output[17] != 39) { return 1; }
    if (output[18] != 85) { return 1; }
    return 0;
}
