fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value < 0)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = (0 - value);
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = 28;
    input[1] = 60;
    input[2] = -61;
    input[3] = 26;
    input[4] = 89;
    input[5] = 52;
    input[6] = -82;
    input[7] = -22;
    input[8] = -3;
    input[9] = -66;
    input[10] = 91;
    input[11] = -16;
    input[12] = -18;
    input[13] = -27;
    input[14] = 57;
    input[15] = 37;
    input[16] = 99;
    input[17] = 47;
    input[18] = -56;
    input[19] = 26;
    input[20] = 50;
    input[21] = 11;
    input[22] = 47;
    input[23] = -70;
    input[24] = -9;
    input[25] = -77;
    input[26] = 50;
    input[27] = -33;
    input[28] = -32;
    input[29] = -41;
    input[30] = 68;
    input[31] = -72;
    input[32] = -77;
    input[33] = 14;
    input[34] = -78;
    input[35] = 71;
    input[36] = 13;
    input[37] = 7;
    input[38] = 5;
    if (process(&input, 39, &mut output) != 18) { return 1; }
    if (output[0] != 61) { return 1; }
    if (output[1] != 82) { return 1; }
    if (output[2] != 22) { return 1; }
    if (output[3] != 3) { return 1; }
    if (output[4] != 66) { return 1; }
    if (output[5] != 16) { return 1; }
    if (output[6] != 18) { return 1; }
    if (output[7] != 27) { return 1; }
    if (output[8] != 56) { return 1; }
    if (output[9] != 70) { return 1; }
    if (output[10] != 9) { return 1; }
    if (output[11] != 77) { return 1; }
    if (output[12] != 33) { return 1; }
    if (output[13] != 32) { return 1; }
    if (output[14] != 41) { return 1; }
    if (output[15] != 72) { return 1; }
    if (output[16] != 77) { return 1; }
    if (output[17] != 78) { return 1; }
    return 0;
}
