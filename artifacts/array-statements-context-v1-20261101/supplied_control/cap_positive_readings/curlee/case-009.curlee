fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if ((value <= 2)) {
                if (outlen < 0 || outlen >= 512) { return -1; }
                output[outlen] = value;
                outlen = outlen + 1;
            }
        }
        if ((value > 2)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 2;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = 68;
    input[1] = 65;
    input[2] = 45;
    input[3] = 25;
    input[4] = -82;
    input[5] = 57;
    input[6] = 61;
    input[7] = 83;
    input[8] = 43;
    input[9] = 86;
    input[10] = -40;
    input[11] = -72;
    input[12] = 92;
    input[13] = 17;
    input[14] = 63;
    input[15] = -90;
    input[16] = -76;
    input[17] = -51;
    input[18] = 39;
    input[19] = -78;
    input[20] = -65;
    input[21] = 29;
    input[22] = -64;
    input[23] = 33;
    input[24] = 23;
    input[25] = 0;
    input[26] = 1;
    input[27] = 81;
    input[28] = -52;
    if (process(&input, 29, &mut output) != 18) { return 1; }
    if (output[0] != 2) { return 1; }
    if (output[1] != 2) { return 1; }
    if (output[2] != 2) { return 1; }
    if (output[3] != 2) { return 1; }
    if (output[4] != 2) { return 1; }
    if (output[5] != 2) { return 1; }
    if (output[6] != 2) { return 1; }
    if (output[7] != 2) { return 1; }
    if (output[8] != 2) { return 1; }
    if (output[9] != 2) { return 1; }
    if (output[10] != 2) { return 1; }
    if (output[11] != 2) { return 1; }
    if (output[12] != 2) { return 1; }
    if (output[13] != 2) { return 1; }
    if (output[14] != 2) { return 1; }
    if (output[15] != 2) { return 1; }
    if (output[16] != 1) { return 1; }
    if (output[17] != 2) { return 1; }
    return 0;
}
