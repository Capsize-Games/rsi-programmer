fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 512]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let outlen: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant outlen >= 0 && outlen <= 2 * i; ] {
        if (i < 0 || i >= 256) { return -1; }
        let value: Int = input[i];
        if ((value > 0)) {
            if ((value <= 2)) {
                if (outlen < 0 || outlen >= 512) { return -1; }
                output[outlen] = value;
                outlen = outlen + 1;
            }
        }
        if ((value > 2)) {
            if (outlen < 0 || outlen >= 512) { return -1; }
            output[outlen] = 2;
            outlen = outlen + 1;
        }
    }
    return outlen;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let output: [Int; 512] = [0; 512];
    input[0] = -53;
    input[1] = 36;
    input[2] = -33;
    input[3] = 17;
    input[4] = 71;
    input[5] = -24;
    input[6] = 54;
    input[7] = -47;
    input[8] = -80;
    input[9] = 32;
    input[10] = -90;
    input[11] = 24;
    input[12] = -1;
    input[13] = 23;
    input[14] = 39;
    input[15] = 5;
    input[16] = -76;
    input[17] = 75;
    input[18] = 31;
    input[19] = 13;
    if (process(&input, 20, &mut output) != 12) { return 1; }
    if (output[0] != 2) { return 1; }
    if (output[1] != 2) { return 1; }
    if (output[2] != 2) { return 1; }
    if (output[3] != 2) { return 1; }
    if (output[4] != 2) { return 1; }
    if (output[5] != 2) { return 1; }
    if (output[6] != 2) { return 1; }
    if (output[7] != 2) { return 1; }
    if (output[8] != 2) { return 1; }
    if (output[9] != 2) { return 1; }
    if (output[10] != 2) { return 1; }
    if (output[11] != 2) { return 1; }
    return 0;
}
