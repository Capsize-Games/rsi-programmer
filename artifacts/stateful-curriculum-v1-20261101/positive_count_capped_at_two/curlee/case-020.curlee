fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((((value % 2) % 2) == (acc - (acc - value)))) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 2;
    input[1] = -93;
    input[2] = -49;
    input[3] = -99;
    input[4] = -9;
    input[5] = -15;
    input[6] = 11;
    input[7] = 72;
    input[8] = -70;
    input[9] = -86;
    input[10] = -43;
    input[11] = 65;
    input[12] = 58;
    input[13] = 84;
    input[14] = -67;
    if (process(&input, 15) != 2) {
        return 1;
    }
    return 0;
}
