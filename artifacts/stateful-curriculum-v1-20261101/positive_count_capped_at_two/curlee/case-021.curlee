fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((((value % 2) % 2) == (acc - (acc - value)))) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -31;
    input[1] = 1;
    input[2] = 55;
    input[3] = 44;
    input[4] = 73;
    input[5] = 62;
    input[6] = 35;
    input[7] = -45;
    input[8] = -5;
    input[9] = 72;
    input[10] = -85;
    input[11] = -82;
    input[12] = -82;
    input[13] = 90;
    input[14] = -9;
    input[15] = 56;
    input[16] = 35;
    input[17] = 34;
    input[18] = -67;
    input[19] = 95;
    if (process(&input, 20) != 2) {
        return 1;
    }
    return 0;
}
