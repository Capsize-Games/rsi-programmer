fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((0 - value) < acc)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -12;
    input[1] = 76;
    input[2] = 0;
    input[3] = -59;
    input[4] = 85;
    input[5] = -29;
    input[6] = -19;
    input[7] = 72;
    input[8] = 3;
    input[9] = -59;
    input[10] = 83;
    input[11] = 58;
    input[12] = 53;
    input[13] = 11;
    input[14] = 42;
    input[15] = -85;
    input[16] = -15;
    input[17] = -58;
    input[18] = 15;
    input[19] = 40;
    input[20] = 5;
    input[21] = 21;
    input[22] = -13;
    input[23] = -6;
    input[24] = -70;
    input[25] = 73;
    input[26] = 35;
    input[27] = -83;
    input[28] = -91;
    input[29] = -75;
    input[30] = -47;
    input[31] = 43;
    input[32] = -97;
    input[33] = -34;
    input[34] = -38;
    input[35] = 0;
    input[36] = -11;
    input[37] = -98;
    if (process(&input, 38) != 85) {
        return 1;
    }
    return 0;
}
