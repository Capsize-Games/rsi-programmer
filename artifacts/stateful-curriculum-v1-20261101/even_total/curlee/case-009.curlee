fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((value % 2) == 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 5;
    input[1] = -14;
    input[2] = 52;
    input[3] = 62;
    input[4] = 7;
    input[5] = 15;
    input[6] = -12;
    input[7] = -99;
    input[8] = -48;
    input[9] = -40;
    input[10] = 35;
    input[11] = -74;
    input[12] = -64;
    input[13] = 44;
    input[14] = -7;
    input[15] = 5;
    input[16] = -96;
    input[17] = 89;
    input[18] = -45;
    input[19] = 94;
    input[20] = -1;
    input[21] = -89;
    if (process(&input, 22) != -96) {
        return 1;
    }
    return 0;
}
