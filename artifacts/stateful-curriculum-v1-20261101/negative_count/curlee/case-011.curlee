fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value < 0)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -6;
    input[1] = 32;
    input[2] = -93;
    input[3] = 39;
    input[4] = -34;
    input[5] = 92;
    input[6] = 91;
    input[7] = 31;
    input[8] = -97;
    input[9] = 92;
    input[10] = -73;
    input[11] = 63;
    input[12] = -69;
    input[13] = -76;
    input[14] = -89;
    input[15] = -93;
    input[16] = 8;
    input[17] = -13;
    input[18] = -51;
    if (process(&input, 19) != 11) {
        return 1;
    }
    return 0;
}
