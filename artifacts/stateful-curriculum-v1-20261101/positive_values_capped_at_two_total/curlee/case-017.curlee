fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if (((0 - value) < acc)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 11;
    input[1] = 85;
    input[2] = -8;
    input[3] = 72;
    input[4] = 32;
    input[5] = 52;
    input[6] = 18;
    input[7] = 2;
    input[8] = -29;
    input[9] = 81;
    input[10] = 47;
    input[11] = -23;
    input[12] = 14;
    input[13] = 72;
    input[14] = 48;
    input[15] = 5;
    input[16] = -90;
    input[17] = -23;
    input[18] = 4;
    input[19] = -6;
    if (process(&input, 20) != 28) {
        return 1;
    }
    return 0;
}
