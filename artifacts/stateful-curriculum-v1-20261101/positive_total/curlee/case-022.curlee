fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + value);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = 12;
    input[1] = -63;
    input[2] = -9;
    input[3] = -68;
    input[4] = 39;
    input[5] = -94;
    input[6] = 72;
    input[7] = 72;
    input[8] = -95;
    input[9] = 35;
    input[10] = 45;
    input[11] = -77;
    input[12] = 100;
    input[13] = -14;
    input[14] = 96;
    input[15] = 62;
    input[16] = -63;
    input[17] = 81;
    input[18] = 26;
    input[19] = 6;
    input[20] = -51;
    input[21] = -40;
    input[22] = 80;
    input[23] = -20;
    input[24] = 12;
    if (process(&input, 25) != 738) {
        return 1;
    }
    return 0;
}
