fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 2)) {
            acc = (acc + 1);
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -21;
    input[1] = -93;
    input[2] = 56;
    input[3] = 80;
    input[4] = 20;
    input[5] = 93;
    input[6] = 6;
    input[7] = -63;
    input[8] = 31;
    input[9] = 4;
    input[10] = 65;
    input[11] = 38;
    input[12] = -79;
    input[13] = 45;
    input[14] = -34;
    input[15] = -71;
    input[16] = 96;
    input[17] = 26;
    input[18] = -16;
    input[19] = -35;
    input[20] = -71;
    input[21] = -42;
    input[22] = 97;
    input[23] = -9;
    input[24] = 31;
    input[25] = -2;
    input[26] = -24;
    input[27] = 13;
    input[28] = -92;
    if (process(&input, 29) != 15) {
        return 1;
    }
    return 0;
}
