fn process(input: &[Int; 256], count: Int) -> Int
    [ requires count >= 0 && count <= 256; ] {
    let acc: Int = 0;
    for (i in 0..count)
        [ invariant count >= 0 && count <= 256; ] {
        if (i < 0 || i >= 256) { return 0; }
        let value: Int = input[i];
        if ((value > 0)) {
            acc = (acc + (value * value));
        }
    }
    return acc;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    input[0] = -43;
    input[1] = -87;
    input[2] = -75;
    input[3] = -43;
    input[4] = 28;
    input[5] = 27;
    input[6] = -57;
    input[7] = 88;
    input[8] = -50;
    input[9] = -88;
    input[10] = 93;
    input[11] = -65;
    input[12] = 57;
    input[13] = 42;
    input[14] = -17;
    input[15] = 97;
    input[16] = -4;
    input[17] = -80;
    input[18] = 1;
    input[19] = 34;
    input[20] = 28;
    input[21] = 0;
    input[22] = 73;
    input[23] = -3;
    if (process(&input, 24) != 39598) {
        return 1;
    }
    return 0;
}
