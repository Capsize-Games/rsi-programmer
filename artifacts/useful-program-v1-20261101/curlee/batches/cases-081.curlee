fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 256]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    if (count < 0 || count > 256) { return -1; }
    let s0: [Int; 256] = [0; 256];
    let len0: Int = 0;
    for (i0 in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant len0 >= 0 && len0 <= i0; ] {
        if (i0 < 0 || i0 >= 256 || len0 < 0 || len0 >= 256) { return -1; }
        let value: Int = input[i0];
        if (value > 0) {
            s0[len0] = value;
            len0 = len0 + 1;
        }
    }
    let s1: [Int; 256] = [0; 256];
    let len1: Int = 0;
    for (i1 in 0..len0)
        [ invariant len0 >= 0 && len0 <= 256;
          invariant len1 >= 0 && len1 <= i1; ] {
        if (i1 < 0 || i1 >= 256 || len1 < 0 || len1 >= 256) { return -1; }
        let value: Int = s0[i1];
        let duplicate: Bool = false;
        for (j1 in 0..len1)
            [ invariant len1 >= 0 && len1 <= i1;
              invariant i1 >= 0 && i1 < len0;
              invariant len0 <= 256; ] {
            if (j1 < 0 || j1 >= 256) { return -1; }
            if (s1[j1] == value) {
                duplicate = true;
            }
        }
        if (!duplicate) {
            s1[len1] = value;
            len1 = len1 + 1;
        }
    }
    let s2: [Int; 256] = [0; 256];
    let len2: Int = 0;
    for (i2 in 0..len1)
        [ invariant len1 >= 0 && len1 <= 256;
          invariant len2 >= 0 && len2 <= i2; ] {
        if (i2 < 0 || i2 >= 256 || len2 < 0 || len2 >= 256) { return -1; }
        let value: Int = s1[i2];
        s2[len2] = value;
        len2 = len2 + 1;
    }
    if (len2 > 1) {
    for (a2 in 0..len2)
        [ invariant len2 > 1 && len2 <= 256; ] {
        for (b2 in 0..(len2 - 1))
            [ invariant len2 > 1 && len2 <= 256; ] {
            if (b2 < 0 || b2 >= 255) { return -1; }
            let first: Int = s2[b2];
            let second: Int = s2[b2 + 1];
            if (first > second) {
                s2[b2] = second;
                s2[b2 + 1] = first;
            }
        }
    }
    }
    for (i in 0..len2)
        [ invariant len2 >= 0 && len2 <= 256; ] {
        if (i < 0 || i >= 256) { return -1; }
        output[i] = s2[i];
    }
    return len2;
}

fn correct(input: &[Int; 256], count: Int,
           expected: &[Int; 256], expected_count: Int) -> Bool
    [ requires count >= 0 && count <= 256;
      requires expected_count >= 0 && expected_count <= 256; ]
{
    let output: [Int; 256] = [0; 256];
    let size: Int = process(&input, count, &mut output);
    if (size != expected_count) { return false; }
    for (i in 0..expected_count)
        [ invariant expected_count >= 0 && expected_count <= 256; ] {
        if (i < 0 || i >= 256) { return false; }
        if (output[i] != expected[i]) { return false; }
    }
    return true;
}

fn main() -> Int {
    let input: [Int; 256] = [0; 256];
    let expected: [Int; 256] = [0; 256];
    input[0] = -75;
    input[1] = 0;
    input[2] = -36;
    input[3] = -37;
    input[4] = -88;
    input[5] = 78;
    input[6] = -82;
    input[7] = 70;
    input[8] = 10;
    input[9] = -10;
    input[10] = 50;
    input[11] = 1;
    input[12] = -65;
    input[13] = -27;
    input[14] = -9;
    input[15] = 90;
    input[16] = 49;
    input[17] = -52;
    input[18] = -93;
    input[19] = 39;
    input[20] = 43;
    input[21] = -10;
    input[22] = 28;
    input[23] = -100;
    input[24] = -51;
    input[25] = 9;
    input[26] = 17;
    input[27] = 90;
    input[28] = -87;
    input[29] = -55;
    input[30] = 4;
    input[31] = 38;
    input[32] = 25;
    input[33] = 75;
    input[34] = -86;
    input[35] = 86;
    input[36] = -47;
    input[37] = -30;
    input[38] = -17;
    input[39] = 80;
    input[40] = -78;
    input[41] = 49;
    expected[0] = 1;
    expected[1] = 4;
    expected[2] = 9;
    expected[3] = 10;
    expected[4] = 17;
    expected[5] = 25;
    expected[6] = 28;
    expected[7] = 38;
    expected[8] = 39;
    expected[9] = 43;
    expected[10] = 49;
    expected[11] = 50;
    expected[12] = 70;
    expected[13] = 75;
    expected[14] = 78;
    expected[15] = 80;
    expected[16] = 86;
    expected[17] = 90;
    if (!correct(&input, 42, &expected, 18)) { return 1; }
    return 0;
}
