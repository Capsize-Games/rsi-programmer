fn process(input: &[Int; 256], count: Int,
           output: &mut [Int; 256]) -> Int
    [ requires count >= 0 && count <= 256; ] {
    if (count < 0 || count > 256) { return -1; }
    let s0: [Int; 256] = [0; 256];
    let len0: Int = 0;
    for (i0 in 0..count)
        [ invariant count >= 0 && count <= 256;
          invariant len0 >= 0 && len0 <= i0; ] {
        if (i0 < 0 || i0 >= 256 || len0 < 0 || len0 >= 256) { return -1; }
        let value: Int = input[i0];
        if (value > 0) {
            s0[len0] = value;
            len0 = len0 + 1;
        }
    }
    let s1: [Int; 256] = [0; 256];
    let len1: Int = 0;
    for (i1 in 0..len0)
        [ invariant len0 >= 0 && len0 <= 256;
          invariant len1 >= 0 && len1 <= i1; ] {
        if (i1 < 0 || i1 >= 256 || len1 < 0 || len1 >= 256) { return -1; }
        let value: Int = s0[i1];
        let duplicate: Bool = false;
        for (j1 in 0..len1)
            [ invariant len1 >= 0 && len1 <= i1;
              invariant i1 >= 0 && i1 < len0;
              invariant len0 <= 256; ] {
            if (j1 < 0 || j1 >= 256) { return -1; }
            if (s1[j1] == value) {
                duplicate = true;
            }
        }
        if (!duplicate) {
            s1[len1] = value;
            len1 = len1 + 1;
        }
    }
    let s2: [Int; 256] = [0; 256];
    let len2: Int = 0;
    for (i2 in 0..len1)
        [ invariant len1 >= 0 && len1 <= 256;
          invariant len2 >= 0 && len2 <= i2; ] {
        if (i2 < 0 || i2 >= 256 || len2 < 0 || len2 >= 256) { return -1; }
        let value: Int = s1[i2];
        s2[len2] = value;
        len2 = len2 + 1;
    }
    if (len2 > 1) {
    for (a2 in 0..len2)
        [ invariant len2 > 1 && len2 <= 256; ] {
        for (b2 in 0..(len2 - 1))
            [ invariant len2 > 1 && len2 <= 256; ] {
            if (b2 < 0 || b2 >= 255) { return -1; }
            let first: Int = s2[b2];
            let second: Int = s2[b2 + 1];
            if (first > second) {
                s2[b2] = second;
                s2[b2 + 1] = first;
            }
        }
    }
    }
    for (i in 0..len2)
        [ invariant len2 >= 0 && len2 <= 256; ] {
        if (i < 0 || i >= 256) { return -1; }
        output[i] = s2[i];
    }
    return len2;
}

fn correct(input: &[Int; 256], count: Int,
           expected: &[Int; 256], expected_count: Int) -> Bool
    [ requires count >= 0 && count <= 256;
      requires expected_count >= 0 && expected_count <= 256; ]
{
    let output: [Int; 256] = [0; 256];
    let size: Int = process(&input, count, &mut output);
    if (size != expected_count) { return false; }
    for (i in 0..expected_count)
        [ invariant expected_count >= 0 && expected_count <= 256; ] {
        if (i < 0 || i >= 256) { return false; }
        if (output[i] != expected[i]) { return false; }
    }
    return true;
}

